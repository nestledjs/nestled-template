{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["api-prisma:generate", "^build"],
      "options": {
        "command": "NODE_ENV=production webpack-cli --config apps/api/webpack.config.js"
      },
      "configurations": {
        "development": {
          "command": "NODE_ENV=development webpack-cli --config apps/api/webpack.config.js"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["api-prisma:generate"],
      "cache": true,
      "inputs": [
        "production",
        "^production",
        {
          "externalDependencies": ["typescript", "prisma", "@prisma/client"]
        }
      ],
      "options": {
        "command": "tsc -p apps/api/tsconfig.typecheck.json"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "api:build:development"
        },
        "production": {
          "buildTarget": "api:build:production"
        }
      }
    }
  },
  "tags": []
}
