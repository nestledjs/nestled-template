{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "typegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "react-router typegen",
        "cwd": "apps/web"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["typegen"],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/scripts/typecheck-project.mjs",
        "{workspaceRoot}/pnpm-lock.yaml",
        {
          "externalDependencies": [
            "typescript",
            "react-router",
            "@react-router/dev",
            "@react-router/node",
            "@react-router/serve",
            "@react-router/express"
          ]
        }
      ],
      "options": {
        "command": "node scripts/typecheck-project.mjs apps/web"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf .react-router/types",
        "cwd": "apps/web"
      }
    },
    "react-router:build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/web"],
      "options": {
        "command": "cd apps/web && npx react-router build",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["typegen"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/build"],
      "defaultConfiguration": "production",
      "options": {
        "command": "react-router build",
        "cwd": "apps/web"
      },
      "configurations": {
        "development": {
          "args": "--mode development"
        },
        "production": {
          "args": "--mode production"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "defaultConfiguration": "development",
      "options": {
        "command": "vite",
        "cwd": "apps/web"
      },
      "configurations": {
        "development": {
          "args": "--mode development"
        },
        "production": {
          "args": "--mode production"
        }
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "defaultConfiguration": "development",
      "options": {
        "command": "vite preview",
        "cwd": "apps/web"
      },
      "configurations": {
        "development": {
          "args": "--mode development"
        },
        "production": {
          "args": "--mode production"
        }
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/apps/web"
      ],
      "options": {
        "coverage.reportsDirectory": "../../coverage/apps/web"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "web:build",
        "spa": true
      },
      "readyWhen": {
        "signal": true
      }
    }
  }
}
