{
  "name": "api-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["api"],
  "targets": {
    "e2e": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{workspaceRoot}/coverage/{e2eProjectRoot}",
        "{workspaceRoot}/test-results/{e2eProjectRoot}"
      ],
      "options": {
        "config": "apps/api-e2e/vitest.config.mts",
        "passWithNoTests": true
      },
      "dependsOn": ["api:build", "test-support"]
    },
    "test": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "outputs": [
        "{workspaceRoot}/coverage/{e2eProjectRoot}",
        "{workspaceRoot}/test-results/{e2eProjectRoot}"
      ],
      "options": {
        "command": "bash apps/api-e2e/run-tests.sh",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": ["test-support"]
    },
    "test-support": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm exec tsc -p apps/api-e2e/tsconfig.support.json",
          "pnpm exec vitest run --config apps/api-e2e/vitest.support.config.mts"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
