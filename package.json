{
  "name": "@nestled-template/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.14.0",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "pre-publish": "pnpm exec nx affected -t lint build test:unit --base=develop",
    "db-update": "node scripts/db-update.mjs",
    "db-update:generate": "pnpm run nestled-doctor && pnpm prisma:generate && pnpm verify:prisma-client && nx g @nestledjs/generators:crud && nx g @nestledjs/generators:models && nx g @nestledjs/generators:sdk && nx g @nestledjs/generators:custom && pnpm run nestled-doctor",
    "build:api": "prisma generate --schema=libs/api/prisma/src/lib/schemas/schema.prisma && NODE_OPTIONS='--no-warnings' nx build api --prod",
    "build:web": "nx run web:react-router:build",
    "start:api": "node dist/apps/api/main.js",
    "start:web": "node apps/web/server.js",
    "vite:clean": "rm -rf node_modules/.vite  && rm -rf dist",
    "docker:build": "docker build -f .dev/Dockerfile -t nestled-template .",
    "docker:down": "./scripts/dev-docker.sh down",
    "docker:push": "docker push nestled-template",
    "docker:run": "docker run -it -p 8000:3000 nestled-template",
    "docker:up": "./scripts/dev-docker.sh up -d",
    "docker:logs": "./scripts/dev-docker.sh logs --tail 50",
    "test:db:start": "./scripts/test-db.sh start",
    "test:db:stop": "./scripts/test-db.sh stop",
    "test:db:reset": "./scripts/test-db.sh reset",
    "test:e2e": "./scripts/run-e2e-tests.sh",
    "test:e2e:auth": "./scripts/run-e2e-tests.sh auth",
    "template:create-upgrade-note": "tsx scripts/create-upgrade-note.ts",
    "template:validate-upgrade-notes": "tsx scripts/validate-upgrade-notes.ts",
    "nestled-doctor": "nestled-doctor",
    "security:update-guard-baseline": "nestled-doctor --update-guard-baseline",
    "affected": "nx affected",
    "affected:apps": "nx affected:apps",
    "affected:build": "nx affected:build",
    "affected:dep-graph": "nx affected:dep-graph",
    "affected:e2e": "nx affected:e2e",
    "affected:libs": "nx affected:libs",
    "affected:lint": "nx affected:lint",
    "affected:test": "nx affected:test",
    "dep-graph": "nx dep-graph",
    "dev:api": "nx serve api",
    "format": "nx format:write",
    "format:check": "nx format:check --base=develop",
    "format:write": "nx format:write",
    "help": "nx help",
    "lint": "nx run-many -t lint",
    "nx": "nx",
    "pre-commit:lint": "nx format:write --uncommitted & nx affected --target eslint --uncommitted",
    "test": "nx run-many -t test",
    "test:coverage": "nx run-many -t test -- --coverage",
    "coverage:normalize-lcov": "tsx scripts/normalize-lcov-paths.ts",
    "sonar:local": "pnpm test:coverage && pnpm coverage:normalize-lcov && SONAR_TOKEN=$SONARQUBE_TOKEN sonar-scanner",
    "test:api": "pnpm nx e2e api-e2e",
    "test:ci": "pnpm test:api",
    "update": "nx migrate latest",
    "workspace-generator": "nx workspace-generator",
    "generate:models": "nx g @nestledjs/generators:models",
    "prisma:apply": "pnpm prisma:format && pnpm prisma db push",
    "prisma:db-push": "pnpm prisma db push",
    "prisma:format": "pnpm prisma format",
    "prisma:generate": "pnpm prisma generate",
    "verify:prisma-client": "nestled-verify-prisma-client",
    "prisma:seed": "tsx libs/api/prisma/src/lib/seed/seed.ts",
    "prisma:studio": "pnpm nx prisma:studio api",
    "prisma:reset": "pnpm prisma migrate reset && pnpm prisma:seed",
    "migrate:add-orgs": "tsx scripts/migrate-users-to-orgs.ts",
    "user:delete": "tsx --tsconfig tsconfig.base.json scripts/delete-user.ts",
    "sdk": "graphql-codegen --config libs/shared/sdk/src/codegen.yml",
    "sdk:watch": "pnpm sdk --watch",
    "dev:web": "nx serve web",
    "typecheck": "pnpm nx run-many -t typecheck",
    "typecheck:watch": "cd apps/web && react-router typegen --watch",
    "storybook:web-ui": "nx storybook web-ui",
    "sdk:update-contract-baseline": "nestled-doctor --update-sdk-contract-baseline",
    "verify:selects": "nestled-verify-selects",
    "verify:fragments": "nestled-verify-fragments",
    "verify:select-coverage": "nestled-verify-select-coverage"
  },
