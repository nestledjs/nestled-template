@@ -0,0 +1,58 @@
+import { configuration } from './configuration'
+import { cookieDomainFromSetting } from './cookie-domain'
+
+// The rule the API sets its session cookie's `Domain` with. apps/web/tests/session-cookie.spec.ts
+// runs the same table against the web server's copy (`cookieDomainFromSetting` in
+// apps/web/app/session-cookie.ts); keep the two tables identical.
+const SETTING_CASES: ReadonlyArray<[string | undefined, string | undefined]> = [
+  [undefined, undefined],
+  ['', undefined],
+  ['   ', undefined],
+  ['localhost', undefined],
+  [' localhost ', undefined],
+  ['127.0.0.1', undefined],
+  ['[::1]', undefined],
+  ['127.example.com', '127.example.com'],
+  ['.127.example.com', '.127.example.com'],
+  ['example.com', 'example.com'],
+  ['.example.com', '.example.com'],
+  ['app.example.com', 'app.example.com'],
+  [' .example.com ', '.example.com'],
+  ['.example.com,.example.org', '.example.com'],
+  ['.example.com, .example.org', '.example.com'],
+  [' , .example.com', '.example.com'],
+  ['localhost,.example.com', undefined],
+]
+
+describe('cookieDomainFromSetting', () => {
+  it.each(SETTING_CASES)('API_COOKIE_DOMAIN=%j sets Domain %j', (value, expected) => {
+    expect(cookieDomainFromSetting(value)).toBe(expected)
+  })
+})
+
+describe('configuration() session cookie domain', () => {
+  const original = process.env['API_COOKIE_DOMAIN']
+
+  afterEach(() => {
+    if (original === undefined) delete process.env['API_COOKIE_DOMAIN']
+    else process.env['API_COOKIE_DOMAIN'] = original
+  })
+
+  it('sets the first entry of a comma-separated list', () => {
+    process.env['API_COOKIE_DOMAIN'] = '.example.com,.example.org'
+
+    expect(configuration().api.cookie.options).toMatchObject({ domain: '.example.com' })
+  })
+
+  it('keeps the domain of a host that only starts with 127.', () => {
+    process.env['API_COOKIE_DOMAIN'] = '127.example.com'
+
+    expect(configuration().api.cookie.options).toMatchObject({ domain: '127.example.com' })
+  })
+
+  it.each(['', 'localhost', '127.0.0.1', '[::1]'])('sets no domain for %j', value => {
+    process.env['API_COOKIE_DOMAIN'] = value
+
+    expect(configuration().api.cookie.options).not.toHaveProperty('domain')
+  })
+})
diff --git a/libs/api/config/src/lib/cookie-domain.ts b/libs/api/config/src/lib/cookie-domain.ts
new file mode 100644
index 0000000..eaf501e
--- /dev/null
+++ b/libs/api/config/src/lib/cookie-domain.ts
@@ -0,0 +1,23 @@
+/**
+ * Values of `API_COOKIE_DOMAIN` that mean "no `Domain` attribute" (a host-only cookie). Matched
+ * exactly: a host such as `127.example.com` is an ordinary domain, not a loopback address.
+ */
+export const HOST_ONLY_COOKIE_DOMAINS: readonly string[] = ['localhost', '127.0.0.1', '[::1]']
+
+/**
+ * The `Domain` the API sets its session cookie for, from `API_COOKIE_DOMAIN`. The value may be a
+ * comma-separated list; the first nonempty entry is the cookie's domain. Undefined (a host-only
+ * cookie) when nothing is set or the entry is `localhost`, `127.0.0.1` or `[::1]`.
+ *
+ * The web server applies the same rule (apps/web/app/session-cookie.ts `cookieDomainFromSetting`)
+ * to know which cookie a sign-out must expire; the two share the table in their specs. Change
+ * both together.
+ */
+export function cookieDomainFromSetting(value: string | undefined): string | undefined {
+  const domain = (value ?? '')
+    .split(',')
+    .map(entry => entry.trim())
+    .find(Boolean)
+  if (!domain || HOST_ONLY_COOKIE_DOMAINS.includes(domain)) return undefined
+  return domain
+}
