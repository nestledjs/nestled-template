index 0000000..4e56bdf
--- /dev/null
+++ b/libs/api/prisma/src/lib/migrations/20261025210000_mcp_oauth_token_resource_and_clients/migration.sql
@@ -0,0 +1,20 @@
+-- MCP OAuth: bind newly issued tokens to their resource, and store Dynamic Client Registrations.
+-- Both changes are additive. Existing API tokens get resource NULL and keep working everywhere.
+
+-- AlterTable
+ALTER TABLE "ApiToken" ADD COLUMN     "resource" TEXT;
+
+-- CreateTable
+CREATE TABLE "McpOAuthClient" (
+    "id" TEXT NOT NULL,
+    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updatedAt" TIMESTAMP(3) NOT NULL,
+    "clientName" TEXT NOT NULL,
+    "redirectUris" TEXT[],
+    "lastUsedAt" TIMESTAMP(3),
+
+    CONSTRAINT "McpOAuthClient_pkey" PRIMARY KEY ("id")
+);
+
+-- CreateIndex
+CREATE INDEX "McpOAuthClient_lastUsedAt_idx" ON "McpOAuthClient"("lastUsedAt");
diff --git a/libs/api/prisma/src/lib/schemas/schema.prisma b/libs/api/prisma/src/lib/schemas/schema.prisma
index f1276e5..609b1b2 100644
--- a/libs/api/prisma/src/lib/schemas/schema.prisma
+++ b/libs/api/prisma/src/lib/schemas/schema.prisma
@@ -47,6 +47,30 @@ model ApiToken {
   authGeneration Int           @default(0)
   organizationId String?
   organization   Organization? @relation("ApiToken_belongsTo_Organization", fields: [organizationId], references: [id], onDelete: SetNull)
+  // The RFC 8707 resource the token is bound to. Set on tokens the MCP OAuth token endpoint issues
+  // (the MCP endpoint's URI): such a token is accepted only there. Null for tokens a user creates,
+  // and for MCP tokens issued before binding existed, which keep working everywhere.
+  /// @graphqlOmit
+  resource       String?
+}
+
+/// @skipCrud
+/// Security-sensitive internal OAuth client registrations, made through MCP Dynamic Client
+/// Registration (RFC 7591). Each row's redirect URIs are the only places an authorization code for
+/// that client may be sent, so they change only through registration. Generic CRUD would let an
+/// edit redirect a client's codes, and its tokens with them.
+model McpOAuthClient {
+  /// The OAuth client_id: 32 random hex characters.
+  id           String    @id
+  createdAt    DateTime  @default(now())
+  updatedAt    DateTime  @updatedAt
+  clientName   String
+  redirectUris String[]
+  /// When the client last started an authorization or redeemed a code. Registrations never used,
+  /// or unused for 30 days, are pruned.
+  lastUsedAt   DateTime?
+
+  @@index([lastUsedAt])
 }
 
