diff --git a/.nestled-updates/upgrade-notes/2026-10-07-organization-context-refresh.yaml b/.nestled-updates/upgrade-notes/2026-10-07-organization-context-refresh.yaml
new file mode 100644
index 0000000..79df1ab
--- /dev/null
+++ b/.nestled-updates/upgrade-notes/2026-10-07-organization-context-refresh.yaml
@@ -0,0 +1,38 @@
+id: 2026-10-07-organization-context-refresh
+title: Resolve organization permissions from current membership on each request
+priority: high
+area: auth
+type: security
+delivery: code-patch
+intent: >
+  OrganizationContextService and AuthLoaderService load the current membership, role and permissions
+  from the database for each request. Keep request-scoped reuse and batching, but do not authorize
+  from a cross-request membership cache. Cached active organization IDs are only selection hints;
+  the selected organization still requires a current membership. Preserve project-specific context
+  resolution and API-token scope rules. CI exercises API authorization with Redis enabled.
+  Membership transaction retries remain sequential and bounded to six attempts, with randomInt
+  jitter between attempts.
+  Correct the existing Sonar migration-history exclusion to libs/api/prisma/src/lib/migrations/**;
+  applied SQL remains immutable and is verified through PostgreSQL integration tests.
+why: >
+  Organization-scoped authorization must use current membership and permission state across all
+  administrative and application write paths. Details will follow in a coordinated advisory.
+affectedPaths:
+  - libs/api/utils/src/lib/services/organization-context.service.ts
+  - libs/api/utils/src/lib/services/organization-context.service.spec.ts
+  - libs/api/utils/src/lib/services/auth-loader.service.ts
+  - libs/api/utils/src/lib/services/auth-loader.service.spec.ts
+  - apps/api-e2e/src/auth/organization-billing.spec.ts
+  - .github/workflows/ci.yml
+  - libs/api/custom/src/lib/default/organization/organization.service.ts
+  - sonar-project.properties
+packageReleases: []
+verification:
+  - pnpm exec nx run api-utils:test
+  - pnpm exec nx run api-custom:test
+  - pnpm exec nx run-many -t lint typecheck
+  - pnpm exec vitest run --config apps/api-e2e/vitest.config.mts
+agentHints:
+  - Run the API tests with Redis and PostgreSQL isolated from development and production services.
+  - Preserve the current organization's scope rules and derive permissions from the fresh database result.
+  - This update has no database migration and supports a normal rolling API deployment.
diff --git a/apps/api-e2e/src/auth/organization-billing.spec.ts b/apps/api-e2e/src/auth/organization-billing.spec.ts
index 0b493a5..27a5d7a 100644
--- a/apps/api-e2e/src/auth/organization-billing.spec.ts
+++ b/apps/api-e2e/src/auth/organization-billing.spec.ts
@@ -116,4 +116,37 @@ describe('Authorization: organization billing', () => {
     expect(plan.data.errors).toBeUndefined()
     expect(plan.data.data.currentPlan).toBeNull()
   })
+
+  it.each(['delete', 'demote'] as const)(
+    'checks current permissions after administrative membership %s',
+    async change => {
+      const owner = await TestHelpers.registerUser(UserFactory.create())
+      const organizationId = sql(`SELECT "activeOrganizationId" FROM "User" WHERE id = :'id';`, {
+        id: owner.id,
+      })
+      // Warm the context through a real request before changing the database directly.
+      const allowed = await gql(owner, CURRENT_SUBSCRIPTION, undefined, organizationId)
+      expect(allowed.data.errors).toBeUndefined()
+      if (change === 'delete') {
+        sql(
+          `DELETE FROM "OrganizationMember" WHERE "userId" = :'id' AND "organizationId" = :'orgId';`,
+          {
+            id: owner.id,
+            orgId: organizationId,
+          },
+        )
+      } else {
+        sql(
+          `UPDATE "OrganizationMember" SET "roleId" = (
+          SELECT id FROM "Role" WHERE "organizationId" = :'orgId' AND name = 'Member'
+        ) WHERE "userId" = :'id' AND "organizationId" = :'orgId';`,
+          {
+            id: owner.id,
+            orgId: organizationId,
+          },
+        )
+      }
+      forbidden(await gql(owner, CURRENT_SUBSCRIPTION, undefined, organizationId))
+    },
+  )
 })
