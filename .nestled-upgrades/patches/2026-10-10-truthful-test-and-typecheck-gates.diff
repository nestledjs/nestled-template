+  - apps/api-e2e/src/support/global-setup.ts
+  - apps/api-e2e/src/support/test-setup.ts
+  - apps/api-e2e/src/auth/auth-crud-concurrency.spec.ts
+  - apps/api-e2e/src/support/api-process.ts
+  - apps/api-e2e/src/support/api-process.spec.ts
+  - apps/api-e2e/src/support/api-process.native.spec.ts
