@@ -0,0 +1,123 @@
+import type { ReactNode } from 'react'
+import { act, render, screen } from '@testing-library/react'
+import { createMemoryRouter, RouterProvider } from 'react-router'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { ApolloProvider, createQueryPreloader } from '@apollo/client/react'
+import { ApolloClient, ApolloLink, InMemoryCache, Observable } from '@apollo/client'
+import { MyOrganizationsWithMembers } from '@nestled-template/shared/sdk'
+import { App } from '../../app/app'
+import AuthenticatedLayout, { middleware } from '../../app/routes/_authenticated/_layout'
+import { requireSession } from '../../app/session/session-middleware.server'
+import { SIGNED_IN, TEST_USER } from '../helpers/session-context'
+
+// The signed-in layout under the real App. requireSession has judged the request before this
+// layout's loader runs (session-middleware.spec covers every verdict through the request handler),
+// so here the root loader returns a signed-in verdict and the layout only renders it.
+
+vi.mock('@nestled-template/web-ui', () => ({
+  WebUiHeader: ({ userName }: { userName?: string }) => <p>Header user: {userName}</p>,
+  WebUiFooter: () => null,
+}))
+vi.mock('@nestled-template/web', async importOriginal => ({
+  ...(await importOriginal<typeof import('@nestled-template/web')>()),
+  SubscriptionProvider: ({ children }: { children: ReactNode }) => children,
+  SubscriptionStatusBanner: () => null,
+  EmulationBanner: () => null,
+}))
+
+const operations: string[] = []
+
+function organizationsLink(organizations: unknown[]) {
+  return new ApolloLink(
+    operation =>
+      new Observable<ApolloLink.Result>(observer => {
+        operations.push(operation.operationName ?? '')
+        observer.next({ data: { myOrganizations: organizations } })
+        observer.complete()
+      }),
+  )
+}
+
+const ORGANIZATION = {
+  __typename: 'Organization',
+  id: 'org-1',
+  name: 'First Org',
+  slug: 'first-org',
+  createdAt: '2026-01-01T00:00:00.000Z',
+  updatedAt: '2026-01-01T00:00:00.000Z',
+  logo: null,
+  members: [],
+}
+
+async function renderMembers(organizations: unknown[] = [ORGANIZATION]) {
+  const client = new ApolloClient({
+    link: organizationsLink(organizations),
+    cache: new InMemoryCache(),
+  })
+  const preload = createQueryPreloader(client)
+  const router = createMemoryRouter(
+    [
+      {
+        id: 'root',
+        path: '/',
+        loader: () => ({ session: SIGNED_IN, theme: 'light' }),
+        element: <App />,
+        children: [
+          {
+            path: 'members',
+            loader: async () => {
+              const myOrganizationsQueryRef = preload(MyOrganizationsWithMembers)
+              await preload.toPromise(myOrganizationsQueryRef)
+              return { myOrganizationsQueryRef }
+            },
+            element: <AuthenticatedLayout />,
+            children: [{ index: true, element: <p>Members page</p> }],
+          },
+        ],
+      },
+    ],
+    { initialEntries: ['/members'] },
+  )
+  await act(async () => {
+    render(
+      <ApolloProvider client={client}>
+        <RouterProvider router={router} />
+      </ApolloProvider>,
+    )
+  })
+}
+
+beforeEach(() => {
+  operations.length = 0
+  localStorage.clear()
+  vi.spyOn(console, 'error').mockImplementation(() => undefined)
+  vi.spyOn(console, 'warn').mockImplementation(() => undefined)
+})
+
+afterEach(() => {
+  vi.restoreAllMocks()
+  localStorage.clear()
+})
+
+describe('the signed-in layout', () => {
+  it('acts before its loader: requireSession is its only middleware', () => {
+    expect(middleware).toEqual([requireSession])
+  })
+
+  it('renders the verdict’s user with no Me call of its own', async () => {
+    await renderMembers()
+
+    expect(await screen.findByText('Members page')).toBeInTheDocument()
+    expect(
+      screen.getByText(`Header user: ${TEST_USER.firstName} ${TEST_USER.lastName}`),
+    ).toBeInTheDocument()
+    expect(operations).not.toContain('Me')
+  })
+
+  it('keeps a user with no organizations signed in: an empty list is an answer, not a sign-out', async () => {
+    await renderMembers([])
+
+    expect(await screen.findByText('Members page')).toBeInTheDocument()
+    expect(screen.getByText(/^Header user:/)).toBeInTheDocument()
+  })
+})
diff --git a/apps/web/tests/session/session-middleware-unit.spec.ts b/apps/web/tests/session/session-middleware-unit.spec.ts
new file mode 100644
index 0000000..6f5bfb3
--- /dev/null
+++ b/apps/web/tests/session/session-middleware-unit.spec.ts
@@ -0,0 +1,219 @@
+// @vitest-environment node
+import { RouterContextProvider } from 'react-router'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import {
+  __resetApiOutageMemory,
+  recordApiOutage,
+  SESSION_TIMEOUT_MS,
+  SKIP_AUTH_ERROR_REPORT_CONTEXT,
+} from '@nestled-template/shared/apollo'
+import {
+  createSessionMiddleware,
+  fetchMeWithApollo,
+  resolveSession,
+  returnPath,
+  sessionRejectedPath,
+  SESSIONLESS_PATTERNS,
+} from '../../app/session/session-middleware.server'
+import { getSession, requireUser, sessionContext } from '../../app/session'
+
+// Hoisted above the imports by vitest, so the session middleware gets this makeClient.
+const query = vi.hoisted(() => vi.fn())
+vi.mock('@nestled-template/shared/apollo', async importOriginal => {
+  const actual = await importOriginal<typeof import('@nestled-template/shared/apollo')>()
+  return { ...actual, makeClient: vi.fn(() => ({ query })) }
+})
+
+function liveCookie(): string {
+  const payload = Buffer.from(
+    JSON.stringify({ exp: Math.floor(Date.now() / 1000) + 3600 }),
+  ).toString('base64url')
+  return `__session=h.${payload}.s`
+}
+
+const signedInRequest = () =>
+  new Request('http://localhost/members', { headers: { cookie: liveCookie() } })
+
+beforeEach(() => {
+  query.mockReset()
+  __resetApiOutageMemory()
+  vi.spyOn(console, 'warn').mockImplementation(() => undefined)
+})
+
+afterEach(() => {
+  vi.useRealTimers()
+  vi.restoreAllMocks()
+  vi.unstubAllEnvs()
+})
+
+describe('fetchMeWithApollo', () => {
+  it("asks for Me fresh, with errorPolicy 'none' and the error link told to stand aside", async () => {
+    query.mockResolvedValue({ data: { me: { id: 'user-1' } } })
+    const signal = new AbortController().signal
+
+    await expect(fetchMeWithApollo(signedInRequest(), signal)).resolves.toEqual({
+      kind: 'user',
+      user: { id: 'user-1' },
+    })
+    expect(query).toHaveBeenCalledTimes(1)
+    expect(query.mock.calls[0][0]).toMatchObject({
+      fetchPolicy: 'no-cache',
+      errorPolicy: 'none',
+      context: { ...SKIP_AUTH_ERROR_REPORT_CONTEXT, fetchOptions: { signal } },
+    })
+  })
+
+  it('judges a thrown error by status and code', async () => {
+    query.mockRejectedValue(Object.assign(new Error('Unauthorized'), { statusCode: 401 }))
+    await expect(
+      fetchMeWithApollo(signedInRequest(), new AbortController().signal),
+    ).resolves.toEqual({ kind: 'error', cause: 'unauthenticated' })
+  })
+
+  it('reports an aborted call as a timeout', async () => {
+    const controller = new AbortController()
+    controller.abort()
+    query.mockRejectedValue(new DOMException('aborted', 'AbortError'))
+    await expect(fetchMeWithApollo(signedInRequest(), controller.signal)).resolves.toEqual({
+      kind: 'timeout',
+    })
+  })
+})
+
+describe('resolveSession', () => {
+  it('makes no call without a live cookie', async () => {
+    const fetchMe = vi.fn()
+    const { verdict } = await resolveSession(new Request('http://localhost/'), { fetchMe })
+    expect(verdict).toEqual({ kind: 'signed-out', reason: 'no-session' })
+    expect(fetchMe).not.toHaveBeenCalled()
+  })
+
+  it('makes one call when Me answers, two only after a clean 401', async () => {
+    const answers = [
+      { kind: 'error', cause: 'unauthenticated' },
+      { kind: 'error', cause: 'unauthenticated' },
+    ] as const
+    const fetchMe = vi.fn(async () => answers[fetchMe.mock.calls.length - 1])
+    const { verdict } = await resolveSession(signedInRequest(), { fetchMe })
+    expect(verdict).toEqual({ kind: 'signed-out', reason: 'rejected' })
+    expect(fetchMe).toHaveBeenCalledTimes(2)
+
+    const once = vi.fn(async () => ({ kind: 'user', user: { id: 'u' } }) as never)
+    await resolveSession(signedInRequest(), { fetchMe: once })
+    expect(once).toHaveBeenCalledTimes(1)
+  })
+
+  it(`aborts Me at SESSION_TIMEOUT_MS (${SESSION_TIMEOUT_MS} ms) and keeps the session`, async () => {
+    vi.useFakeTimers()
+    let signal: AbortSignal | undefined
+    const fetchMe = vi.fn((_request: Request, s: AbortSignal) => {
+      signal = s
+      return new Promise<never>(() => undefined)
+    })
+    const pending = resolveSession(signedInRequest(), { fetchMe })
+
+    await vi.advanceTimersByTimeAsync(SESSION_TIMEOUT_MS - 1)
+    expect(signal?.aborted).toBe(false)
+    await vi.advanceTimersByTimeAsync(1)
+
+    const { verdict } = await pending
+    expect(signal?.aborted).toBe(true)
+    expect(verdict).toEqual({ kind: 'unknown', reason: 'timeout' })
+    expect(fetchMe).toHaveBeenCalledTimes(1)
+  })
+
+  it('reads the outage memory after the calls, so an outage seen meanwhile counts', async () => {
+    const fetchMe = vi.fn(async () => {
+      recordApiOutage()
+      return { kind: 'error', cause: 'unauthenticated' } as const
+    })
+    const { verdict } = await resolveSession(signedInRequest(), { fetchMe })
+    expect(verdict).toEqual({ kind: 'unknown', reason: 'outage' })
+  })
+
+  it('never lets a fetchMe that throws decide by its message', async () => {
+    const fetchMe = vi.fn(async () => {
+      throw new Error('UNAUTHENTICATED Unauthorized 401')
+    })
+    const { verdict } = await resolveSession(signedInRequest(), { fetchMe })
+    expect(verdict).toEqual({ kind: 'unknown', reason: 'answered-error' })
+  })
+})
+
+describe('createSessionMiddleware', () => {
+  it('skips the sessionless patterns (the web health check never calls the API)', async () => {
+    expect(SESSIONLESS_PATTERNS.has('/healthz')).toBe(true)
+    const fetchMe = vi.fn()
+    const middleware = createSessionMiddleware({ fetchMe })
+    const next = vi.fn(async () => new Response('ok'))
+    await middleware(
+      {
+        request: signedInRequest(),
+        context: new RouterContextProvider(),
+        params: {},
+        pattern: '/healthz',
+      } as never,
+      next,
+    )
+    expect(fetchMe).not.toHaveBeenCalled()
+    expect(next).toHaveBeenCalledTimes(1)
+  })
+
+  it('leaves a redirect alone on a rejected session (the sign-out route expires the cookie)', async () => {
+    const middleware = createSessionMiddleware({
+      fetchMe: async () => ({ kind: 'error', cause: 'unauthenticated' }),
+    })
+    const response = (await middleware(
+      {
+        request: signedInRequest(),
+        context: new RouterContextProvider(),
+        params: {},
+        pattern: '/x',
+      } as never,
+      async () => new Response(null, { status: 302, headers: { Location: '/x' } }),
+    )) as Response
+    expect(response.headers.getSetCookie()).toEqual([])
+  })
+})
+
+describe('sessionRejectedPath (owner decision D3)', () => {
+  it.each([
+    [undefined, '/force-logout'],
+    ['', '/force-logout'],
+    ['  ', '/force-logout'],
+    ['/session-expired', '/session-expired'],
+    [' /session-expired ', '/session-expired'],
+    ['//evil.example', '/force-logout'],
+    ['https://evil.example', '/force-logout'],
+    ['/\\evil.example', '/force-logout'],
+    ['session-expired', '/force-logout'],
+  ])('%j -> %s', (value, path) => {
+    expect(sessionRejectedPath(value)).toBe(path)
+  })
+})
+
+describe('returnPath', () => {
+  it.each([
+    ['http://localhost/members', '/members'],
+    ['http://localhost/members.data', '/members'],
+    ['http://localhost/members?tab=a&_routes=root', '/members?tab=a'],
+    ['http://localhost/members?index&_routes=routes%2Fmembers', '/members'],
+    ['http://localhost/_root.data', '/'],
+  ])('%s -> %s', (url, path) => {
+    expect(returnPath(new URL(url))).toBe(path)
+  })
+})
+
+describe('getSession / requireUser', () => {
+  it('getSession names the missing middleware', () => {
+    expect(() => getSession(new RouterContextProvider())).toThrow(/sessionMiddleware/)
+  })
+
+  it('requireUser is a programming error, not a sign-out, outside requireSession', () => {
+    const context = new RouterContextProvider()
+    context.set(sessionContext, { kind: 'unknown', reason: 'outage' })
+    expect(() => requireUser(context)).toThrow(/requireUser called outside requireSession/)
+    context.set(sessionContext, { kind: 'signed-in', user: { id: 'u' } as never })
+    expect(requireUser(context)).toEqual({ id: 'u' })
+  })
+})
diff --git a/apps/web/tests/session/session-middleware.spec.tsx b/apps/web/tests/session/session-middleware.spec.tsx
new file mode 100644
index 0000000..bd58f8c
--- /dev/null
+++ b/apps/web/tests/session/session-middleware.spec.tsx
@@ -0,0 +1,483 @@
+// @vitest-environment node
+import {
+  createRequestHandler,
+  Outlet,
+  RouterContextProvider,
+  UNSAFE_withComponentProps as withComponentProps,
+  UNSAFE_withErrorBoundaryProps as withErrorBoundaryProps,
+  type ServerBuild,
+} from 'react-router'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { __resetApiOutageMemory, apolloLoader } from '@nestled-template/shared/apollo'
+import * as entryServer from '../../app/entry.server'
+import * as rootModule from '../../app/root'
+import { getSession, requireUser } from '../../app/session'
+import { requireSession } from '../../app/session/session-middleware.server'
+import { SERVER_TROUBLE_TITLE } from '../../app/api-unavailable'
+import { SESSION_UNKNOWN_TITLE } from '../../app/session/session-unknown'
+import { UNAUTHENTICATED_RESULT } from '../helpers/api-rejection'
+
+// The session middleware through React Router's own request handler in PRODUCTION mode, with the
+// real entry.server.tsx and the real root route (middleware, loader, App, Layout, ErrorBoundary).
+// The Me call goes through the production Apollo client to a stubbed `fetch`, as in a deployed app.
+// One case per verdict for a document load, a `.data` client navigation and `.data` revalidations
+// (root only and child only).
+
+const COOKIE_NAME = '__session'
+
+function unexpiredJwt(): string {
+  const payload = Buffer.from(
+    JSON.stringify({ sub: 'user-1', exp: Math.floor(Date.now() / 1000) + 3600 }),
+  ).toString('base64url')
+  return `header.${payload}.signature`
+}
+
+function expiredJwt(): string {
+  const payload = Buffer.from(
+    JSON.stringify({ sub: 'user-1', exp: Math.floor(Date.now() / 1000) - 60 }),
+  ).toString('base64url')
+  return `header.${payload}.signature`
+}
+
+const USER = {
+  __typename: 'User',
+  id: 'user-1',
+  firstName: 'Ada',
+  lastName: 'Lovelace',
+  displayName: null,
+  isSuperAdmin: false,
+  activeOrganizationId: null,
+  emails: [],
+}
+
+// The private layout's and the public page's loaders, so a spec can prove which ran.
+const privateLoader = vi.fn()
+const publicLoader = vi.fn()
+
+function routeEntry(id: string, path: string | undefined, parentId?: string) {
+  return {
+    id,
+    path,
+    parentId,
+    hasAction: false,
+    hasLoader: true,
+    hasClientAction: false,
+    hasClientLoader: false,
+    hasClientMiddleware: false,
+    hasErrorBoundary: id === 'root',
+    module: `/${id}.js`,
+    imports: [],
+    css: [],
+  }
+}
+
+function build(): ServerBuild {
+  const root = {
+    ...rootModule,
+    default: withComponentProps(rootModule.default),
+    ErrorBoundary: withErrorBoundaryProps(rootModule.ErrorBoundary),
+  }
+  return {
+    entry: { module: entryServer },
+    routes: {
+      root: { id: 'root', path: '', module: root },
+      'routes/private': {
+        id: 'routes/private',
+        parentId: 'root',
+        path: '',
+        module: {
+          middleware: [requireSession],
+          loader: ({ context }: { context: RouterContextProvider }) => {
+            privateLoader(requireUser(context).id)
+            return { private: true }
+          },
+          default: () => <Outlet />,
+        },
+      },
+      'routes/members': {
+        id: 'routes/members',
+        parentId: 'routes/private',
+        path: 'members',
+        module: {
+          loader: () => ({ members: true }),
+          default: () => <p>Members page</p>,
+        },
+      },
+      'routes/public': {
+        id: 'routes/public',
+        parentId: 'root',
+        path: 'public',
+        module: {
+          loader: ({ context }: { context: RouterContextProvider }) => {
+            publicLoader(getSession(context).kind)
+            return { public: true }
+          },
+          default: () => <p>Public page</p>,
+        },
+      },
+    },
+    assets: {
+      entry: { imports: [], module: '/entry.client.js' },
+      routes: {
+        root: routeEntry('root', ''),
+        'routes/private': routeEntry('routes/private', '', 'root'),
+        'routes/members': routeEntry('routes/members', 'members', 'routes/private'),
+        'routes/public': routeEntry('routes/public', 'public', 'root'),
+      },
+      url: '/manifest.js',
+      version: 'test',
+    },
+    publicPath: '/',
+    assetsBuildDirectory: 'build/client',
+    future: { v8_middleware: true },
+    ssr: true,
+    isSpaMode: false,
+    prerender: [],
+    routeDiscovery: { mode: 'initial', manifestPath: '/__manifest' },
+  } as unknown as ServerBuild
+}
+
+const handler = createRequestHandler(build(), 'production')
+
+function request(path: string, cookie: string | null = unexpiredJwt()) {
+  return handler(
+    new Request(`http://localhost${path}`, {
+      headers: cookie === null ? {} : { cookie: `${COOKIE_NAME}=${cookie}; theme=dark` },
+    }),
+    new RouterContextProvider(),
+  )
+}
+
+const fetchMock = vi.fn()
+
+function isMeCall(init: RequestInit | undefined): boolean {
+  return typeof init?.body === 'string' && init.body.includes('"operationName":"Me"')
+}
+
+function meCalls(): number {
+  return fetchMock.mock.calls.filter(([, init]) => isMeCall(init)).length
+}
+
+function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'content-type': 'application/json' },
+  })
+}
+
+type Answer = () => Response | Promise<Response>
+
+/** Me answers each call in turn with the next of `answers` (the last one repeats). */
+function meAnswers(...answers: Answer[]) {
+  let call = 0
+  fetchMock.mockImplementation(async (_url: unknown, init?: RequestInit) => {
+    if (!isMeCall(init)) return json({ data: {} })
+    const answer = answers[Math.min(call, answers.length - 1)]
+    call += 1
+    return answer()
+  })
+}
+
+const signedIn: Answer = () => json({ data: { me: USER } })
+const rejected: Answer = () => json(UNAUTHENTICATED_RESULT)
+const unreachable: Answer = () => Promise.reject(new TypeError('fetch failed'))
+const proxy503: Answer = () => json({ message: 'Service Unavailable' }, 503)
+const graphql503: Answer = () =>
+  json({
+    data: null,
+    errors: [{ message: 'Down', extensions: { code: 'INTERNAL_SERVER_ERROR', status: 503 } }],
+  })
+const answered500: Answer = () => json({ message: 'Internal Server Error' }, 500)
+const empty: Answer = () => json({ data: { me: null } })
+// A 500 whose message says "Unauthorized": message text never decides.
+const unauthorizedText: Answer = () =>
+  json({ data: null, errors: [{ message: 'Unauthorized', extensions: { code: 'X' } }] })
+
+function expiredCookies(response: Response): string[] {
+  return response.headers
+    .getSetCookie()
+    .filter(
+      cookie =>
+        cookie.startsWith(`${COOKIE_NAME}=;`) && cookie.includes('Expires=Thu, 01 Jan 1970'),
+    )
+}
+
+beforeEach(() => {
+  fetchMock.mockReset()
+  privateLoader.mockReset()
+  publicLoader.mockReset()
+  __resetApiOutageMemory()
+  vi.stubGlobal('fetch', fetchMock)
+  vi.stubEnv('API_COOKIE_DOMAIN', '.example.com')
+  vi.stubEnv('VITE_COOKIE_DOMAIN', '')
+  vi.spyOn(console, 'error').mockImplementation(() => undefined)
+  vi.spyOn(console, 'log').mockImplementation(() => undefined)
+  vi.spyOn(console, 'warn').mockImplementation(() => undefined)
+})
+
+afterEach(() => {
+  vi.unstubAllGlobals()
+  vi.unstubAllEnvs()
+  vi.restoreAllMocks()
+})
+
+// A document load, a client navigation, and revalidations of the root only and the child only.
+const PRIVATE_REQUESTS = [
+  ['document', '/members'],
+  ['.data navigation', '/members.data'],
+  ['.data revalidation (root only)', '/members.data?_routes=root'],
+  ['.data revalidation (child only)', '/members.data?_routes=routes%2Fmembers'],
+] as const
+
+describe('signed in', () => {
+  it.each(PRIVATE_REQUESTS)('%s: the page, with exactly one Me call', async (kind, path) => {
+    meAnswers(signedIn)
+    const response = await request(path)
+
+    expect(response.status).toBe(200)
+    expect(meCalls()).toBe(1)
+    // A revalidation runs only the loaders it names; the middleware runs every time.
+    if (!kind.startsWith('.data revalidation')) expect(privateLoader).toHaveBeenCalledWith('user-1')
+    if (kind === 'document') expect(await response.text()).toContain('Members page')
+    expect(expiredCookies(response)).toHaveLength(0)
+  })
+
+  it('takes a transient 401 that the confirmation answers with the user as signed in', async () => {
+    meAnswers(rejected, signedIn)
+    const response = await request('/members')
+
+    expect(response.status).toBe(200)
+    expect(meCalls()).toBe(2)
+    expect(privateLoader).toHaveBeenCalledWith('user-1')
+  })
+})
+
+describe('signed out: rejected (a clean 401, confirmed, no outage)', () => {
+  it('document: a 302 to /force-logout, with two Me calls and no private loader', async () => {
+    meAnswers(rejected)
+    const response = await request('/members')
+
+    expect(response.status).toBe(302)
+    expect(response.headers.get('Location')).toBe('/force-logout?return_url=%2Fmembers')
+    expect(meCalls()).toBe(2)
+    expect(privateLoader).not.toHaveBeenCalled()
+  })
+
+  it.each(PRIVATE_REQUESTS.slice(1))(
+    '%s: a single-fetch redirect with reload to /force-logout, no private loader',
+    async (_kind, path) => {
+      meAnswers(rejected)
+      const response = await request(path)
+      const body = await response.text()
+
+      expect(response.status).toBe(202)
+      expect(body).toContain('SingleFetchRedirect')
+      expect(body).toContain('/force-logout?return_url=%2Fmembers')
+      expect(body).toMatch(/"reload",true/)
+      expect(privateLoader).not.toHaveBeenCalled()
+    },
+  )
+
+  it('lands on SESSION_REJECTED_PATH when the app sets one (owner decision D3)', async () => {
+    vi.stubEnv('SESSION_REJECTED_PATH', '/session-expired')
+    meAnswers(rejected)
+    const response = await request('/members')
+
+    expect(response.headers.get('Location')).toBe('/session-expired?return_url=%2Fmembers')
+  })
+
+  it.each([
+    ['document', '/public'],
+    ['.data navigation', '/public.data'],
+  ])(
+    'public %s: renders signed out with both cookie scopes expired in place',
+    async (_kind, path) => {
+      meAnswers(rejected)
+      const response = await request(path)
+
+      expect(response.status).toBe(200)
+      expect(publicLoader).toHaveBeenCalledWith('signed-out')
+      const expired = expiredCookies(response)
+      expect(expired).toHaveLength(2)
+      expect(expired.filter(cookie => cookie.endsWith('; Domain=.example.com'))).toHaveLength(1)
+      expect(expired.filter(cookie => !cookie.includes('Domain='))).toHaveLength(1)
+    },
+  )
+})
+
+describe('signed out: no session', () => {
+  it.each([
+    ['no cookie', null],
+    ['a JWT whose exp has passed', expiredJwt()],
+  ])('%s: a redirect to /login with no Me call', async (_label, cookie) => {
+    meAnswers(signedIn)
+    const response = await request('/members', cookie)
+
+    expect(response.status).toBe(302)
+    expect(response.headers.get('Location')).toBe('/login?return_url=%2Fmembers')
+    expect(meCalls()).toBe(0)
+    expect(privateLoader).not.toHaveBeenCalled()
+    expect(expiredCookies(response)).toHaveLength(0)
+  })
+
+  it('.data navigation: a single-fetch redirect to /login, without a reload', async () => {
+    const response = await request('/members.data', null)
+    const body = await response.text()
+
+    expect(response.status).toBe(202)
+    expect(body).toContain('/login?return_url=%2Fmembers')
+    expect(body).not.toMatch(/"reload",true/)
+    expect(privateLoader).not.toHaveBeenCalled()
+  })
+
+  it('a public page renders signed out', async () => {
+    const response = await request('/public', null)
+    expect(response.status).toBe(200)
+    expect(publicLoader).toHaveBeenCalledWith('signed-out')
+  })
+})
+
+describe('unknown: the session is kept', () => {
+  const OUTAGES: Array<[string, Answer[]]> = [
+    ['Me gets no answer', [unreachable]],
+    ['a proxy answers 503', [proxy503]],
+    ['Me answers a GraphQL 503', [graphql503]],
+    ['Me 401, the confirmation gets no answer', [rejected, unreachable]],
+    ['Me 401, the confirmation answers 503', [rejected, proxy503]],
+  ]
+
+  it.each(OUTAGES)(
+    '%s: document gets the recovering screen (503), cookie kept',
+    async (_l, answers) => {
+      meAnswers(...answers)
+      const response = await request('/members')
+
+      expect(response.status).toBe(503)
+      expect(await response.text()).toContain(SERVER_TROUBLE_TITLE)
+      expect(expiredCookies(response)).toHaveLength(0)
+      expect(response.headers.get('Location')).toBeNull()
+      expect(privateLoader).not.toHaveBeenCalled()
+    },
+  )
+
+  it.each(PRIVATE_REQUESTS.slice(1))(
+    '%s: a 503 SESSION_UNKNOWN route error, no private loader',
+    async (_kind, path) => {
+      meAnswers(unreachable)
+      const response = await request(path)
+      const body = await response.text()
+
+      expect(response.status).toBe(503)
+      expect(body).toContain('SESSION_UNKNOWN')
+      expect(body).not.toContain('SingleFetchRedirect')
+      expect(privateLoader).not.toHaveBeenCalled()
+    },
+  )
+
+  it('Me makes no confirmation call after an outage (one Me call)', async () => {
+    meAnswers(unreachable)
+    await request('/members')
+    expect(meCalls()).toBe(1)
+  })
+
+  it('a clean, confirmed 401 just after another request found the API down is not trusted', async () => {
+    meAnswers(unreachable)
+    await request('/public')
+    meAnswers(rejected)
+    const response = await request('/members')
+
+    expect(response.status).toBe(503)
+    expect(expiredCookies(response)).toHaveLength(0)
+  })
+
+  it.each([
+    ['Me answers 500', [answered500]],
+    ['Me answers null with no error', [empty]],
+    ['Me answers an error whose message says "Unauthorized"', [unauthorizedText]],
+    ['Me 401, the confirmation answers 500', [rejected, answered500]],
+  ] as Array<[string, Answer[]]>)(
+    '%s: "We couldn’t load your account" (503), cookie kept',
+    async (_label, answers) => {
+      meAnswers(...answers)
+      const response = await request('/members')
+
+      expect(response.status).toBe(503)
+      expect(await response.text()).toContain(SESSION_UNKNOWN_TITLE)
+      expect(expiredCookies(response)).toHaveLength(0)
+      expect(privateLoader).not.toHaveBeenCalled()
+    },
+  )
+
+  it('a public page renders with the cookie kept and the verdict unknown', async () => {
+    meAnswers(unreachable)
+    const response = await request('/public')
+
+    expect(response.status).toBe(200)
+    expect(publicLoader).toHaveBeenCalledWith('unknown')
+    expect(expiredCookies(response)).toHaveLength(0)
+  })
+})
+
+describe('the copy', () => {
+  it('names the screen for an unknown verdict that is not an outage', () => {
+    expect(SESSION_UNKNOWN_TITLE).toBe('We couldn’t load your account')
+  })
+})
+
+describe('apolloLoader narrowing on a production .data request', () => {
+  // A child loader that calls the API after the session was judged signed in. Raw errors lose their
+  // status and code to React Router's sanitization; apolloLoader narrows them first.
+  function buildWith(loader: () => unknown): ServerBuild {
+    const base = build()
+    const routes = { ...base.routes }
+    const members = routes['routes/members']
+    if (!members) throw new Error('build() has no members route')
+    routes['routes/members'] = {
+      ...members,
+      module: { ...members.module, loader: apolloLoader()(loader) },
+    }
+    return { ...base, routes }
+  }
+
+  async function membersData(loader: () => unknown) {
+    meAnswers(signedIn)
+    const narrowed = createRequestHandler(buildWith(loader), 'production')
+    const response = await narrowed(
+      new Request('http://localhost/members.data', {
+        headers: { cookie: `${COOKIE_NAME}=${unexpiredJwt()}` },
+      }),
+      new RouterContextProvider(),
+    )
+    return { status: response.status, body: await response.text() }
+  }
+
+  function apolloError(status: number) {
+    return Object.assign(new Error('Response not successful'), { statusCode: status })
+  }
+
+  it('a 401 reaches the browser as 401 API_UNAUTHENTICATED, not a sign-out', async () => {
+    const { status, body } = await membersData(() => {
+      throw apolloError(401)
+    })
+    expect(status).toBe(401)
+    expect(body).toContain('API_UNAUTHENTICATED')
+    expect(body).not.toContain('SingleFetchRedirect')
+  })
+
+  it('no answer reaches the browser as 503 API_UNAVAILABLE', async () => {
+    const { status, body } = await membersData(async () => {
+      throw new TypeError('Failed to fetch')
+    })
+    expect(status).toBe(503)
+    expect(body).toContain('API_UNAVAILABLE')
+  })
+
+  it('a 500 is sanitized as any other server error', async () => {
+    const { status, body } = await membersData(() => {
+      throw apolloError(500)
+    })
+    expect(status).toBe(500)
+    expect(body).toContain('Unexpected Server Error')
+    expect(body).not.toContain('API_UNAVAILABLE')
+  })
+})
diff --git a/apps/web/tests/session/session-revalidator.spec.tsx b/apps/web/tests/session/session-revalidator.spec.tsx
new file mode 100644
index 0000000..70a32e2
--- /dev/null
+++ b/apps/web/tests/session/session-revalidator.spec.tsx
@@ -0,0 +1,343 @@
+import { act, render, screen } from '@testing-library/react'
+import {
+  createMemoryRouter,
+  data,
+  RouterProvider,
+  UNSAFE_ErrorResponseImpl as ErrorResponseImpl,
+} from 'react-router'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import {
+  API_UNAUTHENTICATED_CODE,
+  APOLLO_SESSION_SUSPECT_EVENT,
+  SESSION_REVALIDATE_COOLDOWN_MS,
+} from '@nestled-template/shared/apollo'
+import { ErrorBoundary } from '../../app/root'
+import {
+  __resetSessionRevalidation,
+  requestSessionRevalidation,
+  RevalidateSessionOnMount,
+  SessionRevalidator,
+} from '../../app/session/session-revalidator'
+
+type BoundaryError = Parameters<typeof ErrorBoundary>[0]['error']
+
+const SIGN_OUT_TARGET = /\/(login|logout|force-logout)/
+
+/** Every way the browser could navigate, so a spec can prove it never does by itself. */
+function watchLocation() {
+  const assign = vi.fn()
+  const replace = vi.fn()
+  const hrefs: string[] = []
+  const location = {
+    ...globalThis.location,
+    assign,
+    replace,
+    reload: vi.fn(),
+    get href() {
+      return 'http://localhost/members'
+    },
+    set href(value: string) {
+      hrefs.push(value)
+    },
+  }
+  vi.stubGlobal('location', location)
+  return () => [
+    ...assign.mock.calls.map(([to]) => to),
+    ...replace.mock.calls.map(([to]) => to),
+    ...hrefs,
+  ]
+}
+
+async function renderWith(element: React.ReactNode) {
+  let loaderCalls = 0
+  const router = createMemoryRouter(
+    [
+      {
+        path: '/',
+        loader: () => {
+          loaderCalls += 1
+          return {}
+        },
+        element,
+      },
+    ],
+    { initialEntries: ['/'] },
+  )
+  await act(async () => {
+    render(<RouterProvider router={router} />)
+  })
+  return { revalidations: () => loaderCalls - 1, router }
+}
+
+async function suspect(times = 1) {
+  await act(async () => {
+    for (let index = 0; index < times; index += 1) {
+      globalThis.dispatchEvent(new CustomEvent(APOLLO_SESSION_SUSPECT_EVENT))
+    }
+  })
+}
+
+beforeEach(() => {
+  __resetSessionRevalidation()
+  vi.useFakeTimers({ shouldAdvanceTime: true })
+})
+
+afterEach(() => {
+  vi.useRealTimers()
+  vi.unstubAllGlobals()
+  vi.restoreAllMocks()
+})
+
+describe('SessionRevalidator: a browser 401 only triggers a revalidation', () => {
+  it('answers an error-link 401 with one revalidation', async () => {
+    const navigations = watchLocation()
+    const { revalidations } = await renderWith(<SessionRevalidator />)
+
+    await suspect()
+
+    expect(revalidations()).toBe(1)
+    expect(navigations()).toEqual([])
+  })
+
+  it('answers five 401s within the cooldown with one revalidation now and one after it', async () => {
+    const { revalidations } = await renderWith(<SessionRevalidator />)
+
+    await suspect(5)
+    expect(revalidations()).toBe(1)
+
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(SESSION_REVALIDATE_COOLDOWN_MS - 10)
+    })
+    expect(revalidations()).toBe(1)
+
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(20)
+    })
+    // The held suspicions are coalesced into one revalidation when the cooldown ends.
+    expect(revalidations()).toBe(2)
+
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(SESSION_REVALIDATE_COOLDOWN_MS * 3)
+    })
+    expect(revalidations()).toBe(2)
+  })
+
+  it('keeps a 401 that arrives during the cooldown: a session revoked seconds later is still judged', async () => {
+    const { revalidations } = await renderWith(<SessionRevalidator />)
+
+    await suspect()
+    expect(revalidations()).toBe(1)
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(1_000)
+    })
+    await suspect()
+    expect(revalidations()).toBe(1)
+
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(SESSION_REVALIDATE_COOLDOWN_MS)
+    })
+    expect(revalidations()).toBe(2)
+  })
+
+  it('sends nothing while offline, and one revalidation once the browser reconnects', async () => {
+    const onLine = vi.spyOn(navigator, 'onLine', 'get').mockReturnValue(false)
+    const navigations = watchLocation()
+    const { revalidations } = await renderWith(<SessionRevalidator />)
+
+    await suspect(3)
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(SESSION_REVALIDATE_COOLDOWN_MS * 2)
+    })
+    expect(revalidations()).toBe(0)
+
+    onLine.mockReturnValue(true)
+    await act(async () => {
+      globalThis.dispatchEvent(new Event('online'))
+    })
+    expect(revalidations()).toBe(1)
+
+    await act(async () => {
+      globalThis.dispatchEvent(new Event('online'))
+      await vi.advanceTimersByTimeAsync(SESSION_REVALIDATE_COOLDOWN_MS * 2)
+    })
+    expect(revalidations()).toBe(1)
+    expect(navigations()).toEqual([])
+  })
+
+  it('waits out the cooldown when the browser reconnects inside it', async () => {
+    const onLine = vi.spyOn(navigator, 'onLine', 'get')
+    const { revalidations } = await renderWith(<SessionRevalidator />)
+
+    await suspect()
+    expect(revalidations()).toBe(1)
+
+    onLine.mockReturnValue(false)
+    await suspect()
+    onLine.mockReturnValue(true)
+    await act(async () => {
+      globalThis.dispatchEvent(new Event('online'))
+    })
+    expect(revalidations()).toBe(1)
+
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(SESSION_REVALIDATE_COOLDOWN_MS)
+    })
+    expect(revalidations()).toBe(2)
+  })
+
+  it('never touches location, whatever arrives', async () => {
+    const navigations = watchLocation()
+    await renderWith(<SessionRevalidator />)
+    for (let round = 0; round < 3; round += 1) {
+      await suspect(2)
+      await act(async () => {
+        await vi.advanceTimersByTimeAsync(SESSION_REVALIDATE_COOLDOWN_MS)
+      })
+    }
+    expect(navigations().filter(to => SIGN_OUT_TARGET.test(String(to)))).toEqual([])
+    expect(navigations()).toEqual([])
+  })
+
+  it('requestSessionRevalidation reports whether it asked', () => {
+    const revalidate = vi.fn()
+    expect(requestSessionRevalidation(revalidate, 1_000)).toBe(true)
+    expect(requestSessionRevalidation(revalidate, 1_001)).toBe(false)
+    expect(requestSessionRevalidation(revalidate, 1_000 + SESSION_REVALIDATE_COOLDOWN_MS)).toBe(
+      true,
+    )
+    expect(revalidate).toHaveBeenCalledTimes(2)
+  })
+})
+
+describe('root ErrorBoundary with a route 401', () => {
+  const route401 = new ErrorResponseImpl(401, 'Unauthorized', { code: API_UNAUTHENTICATED_CODE })
+
+  it('revalidates once, then shows the route error screen with a retry; never signs out', async () => {
+    const navigations = watchLocation()
+    const { revalidations } = await renderWith(
+      <ErrorBoundary error={route401 as unknown as BoundaryError} />,
+    )
+
+    expect(revalidations()).toBe(1)
+    expect(screen.getByText('401')).toBeInTheDocument()
+    expect(screen.getByRole('button', { name: 'Try again' })).toBeInTheDocument()
+    expect(navigations()).toEqual([])
+  })
+
+  it('shares the cooldown with the error link: a 401 storm is one revalidation', async () => {
+    const { revalidations } = await renderWith(
+      <>
+        <SessionRevalidator />
+        <ErrorBoundary error={route401 as unknown as BoundaryError} />
+      </>,
+    )
+    await suspect(3)
+    expect(revalidations()).toBe(1)
+  })
+
+  it('treats any route 401 the same, whatever its message', async () => {
+    const navigations = watchLocation()
+    const { revalidations } = await renderWith(
+      <ErrorBoundary
+        error={new ErrorResponseImpl(401, 'Session expired', null) as unknown as BoundaryError}
+      />,
+    )
+    expect(revalidations()).toBe(1)
+    expect(navigations()).toEqual([])
+  })
+
+  it.each(['/settings', '/settings#security'])(
+    'gives way to the page once the retry succeeds, even when it settles at once (%s)',
+    async url => {
+      let calls = 0
+      const router = createMemoryRouter(
+        [
+          {
+            path: '/settings',
+            loader: () => {
+              calls += 1
+              if (calls === 1) throw data({ code: API_UNAUTHENTICATED_CODE }, { status: 401 })
+              return {}
+            },
+            element: <p>the page</p>,
+            ErrorBoundary: () => (
+              <RevalidateSessionOnMount>
+                <p>401 screen</p>
+              </RevalidateSessionOnMount>
+            ),
+          },
+        ],
+        { initialEntries: [url] },
+      )
+      await act(async () => {
+        render(<RouterProvider router={router} />)
+      })
+      await act(async () => {
+        await vi.advanceTimersByTimeAsync(100)
+      })
+
+      expect(screen.getByText('the page')).toBeInTheDocument()
+      // One failed load, one retry: no extra load to reset the boundary.
+      expect(calls).toBe(2)
+      expect(router.state.location).toMatchObject({
+        pathname: '/settings',
+        hash: new URL(url, 'http://localhost').hash,
+      })
+    },
+  )
+
+  it('a retry held through the cooldown runs as a plain revalidation once the user has left the error screen', async () => {
+    let settingsCalls = 0
+    let otherCalls = 0
+    const router = createMemoryRouter(
+      [
+        {
+          path: '/settings',
+          loader: () => {
+            settingsCalls += 1
+            throw data({ code: API_UNAUTHENTICATED_CODE }, { status: 401 })
+          },
+          element: <p>settings</p>,
+          ErrorBoundary: () => (
+            <RevalidateSessionOnMount>
+              <p>401 screen</p>
+            </RevalidateSessionOnMount>
+          ),
+        },
+        {
+          path: '/other',
+          loader: () => {
+            otherCalls += 1
+            return {}
+          },
+          element: <p>other page</p>,
+        },
+      ],
+      { initialEntries: ['/settings'] },
+    )
+    // A revalidation just happened elsewhere, so the 401 screen's request is held for the cooldown.
+    requestSessionRevalidation(() => undefined)
+    await act(async () => {
+      render(<RouterProvider router={router} />)
+    })
+    expect(screen.getByText('401 screen')).toBeInTheDocument()
+
+    // The user leaves the error screen before the cooldown ends.
+    await act(async () => {
+      await router.navigate('/other')
+    })
+    expect(screen.getByText('other page')).toBeInTheDocument()
+    const left = router.state.location
+    const otherBefore = otherCalls
+
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(SESSION_REVALIDATE_COOLDOWN_MS + 100)
+    })
+
+    // The held retry revalidated the page now showing, and did not navigate it.
+    expect(otherCalls).toBe(otherBefore + 1)
+    expect(router.state.location.key).toBe(left.key)
+    expect(router.state.location.pathname).toBe('/other')
+    expect(settingsCalls).toBe(1)
+  })
+})
