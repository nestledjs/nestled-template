diff --git a/scripts/postgres-readiness.spec.mjs b/scripts/postgres-readiness.spec.mjs
new file mode 100644
index 0000000..0783d87
--- /dev/null
+++ b/scripts/postgres-readiness.spec.mjs
@@ -0,0 +1,80 @@
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+import { describe, it } from 'node:test'
+import { fileURLToPath } from 'node:url'
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..')
+
+/**
+ * Every `pg_isready` probe the workspace waits on asks over TCP, not the Unix socket.
+ *
+ * On a fresh data directory (every CI run, every first local start) the postgres image's
+ * entrypoint runs `initdb`, starts a TEMPORARY server to execute `/docker-entrypoint-initdb.d`,
+ * stops it, and only then starts the server that stays. The temporary server gets
+ * `-c listen_addresses=''`: it answers on the socket and nowhere else. A socket probe therefore
+ * succeeds for a server about to shut down, and whatever runs next races it:
+ *
+ *   createdb: error: connection to server on socket "…/.s.PGSQL.5432" failed:
+ *             FATAL:  the database system is shutting down
+ *
+ * That turned the generated-artifacts job red intermittently. A source-shape check rather than a
+ * behavioural one: the probes talk to a Docker daemon, and `db-update.mjs` runs on import.
+ */
+const PROBED_FILES = ['scripts/db-update.mjs', 'scripts/test-db.sh', '.dev/docker-compose.yml']
+
+/** Each `pg_isready` in `source`, with the text that follows it, up to the next one. */
+function readinessProbes(source) {
+  const probes = []
+  const pattern = /pg_isready/g
+  let match = pattern.exec(source)
+  while (match !== null) {
+    const next = source.indexOf('pg_isready', match.index + 1)
+    const end = next === -1 ? source.length : next
+    probes.push(source.slice(match.index, Math.min(end, match.index + 300)))
+    match = pattern.exec(source)
+  }
+  return probes
+}
+
+function asksOverTcp(probe) {
+  return /-h['",\s]+127\.0\.0\.1/.test(probe)
+}
+
+describe('Postgres readiness probes', () => {
+  for (const file of PROBED_FILES) {
+    it(`${file} waits on the lasting server over TCP, not the init socket`, () => {
+      const probes = readinessProbes(readFileSync(join(root, file), 'utf8'))
+
+      assert.ok(probes.length > 0, `${file} has no pg_isready probe to check`)
+      for (const probe of probes) {
+        assert.ok(
+          asksOverTcp(probe),
+          `${file}: a pg_isready probe does not pass -h 127.0.0.1, so it asks over the Unix ` +
+            `socket and can answer for the temporary initdb server:\n${probe.slice(0, 80)}`,
+        )
+      }
+    })
+  }
+
+  it('fails a socket-only probe', () => {
+    const probes = readinessProbes('docker exec "$C" pg_isready -U postgres > /dev/null')
+
+    assert.equal(probes.length, 1)
+    assert.equal(asksOverTcp(probes[0]), false)
+  })
+
+  it('reads each probe separately rather than letting one cover the next', () => {
+    const probes = readinessProbes(
+      'pg_isready -h 127.0.0.1 -U a\n' + 'x'.repeat(400) + '\npg_isready -U b\n',
+    )
+
+    assert.equal(probes.length, 2)
+    assert.equal(asksOverTcp(probes[0]), true)
+    assert.equal(asksOverTcp(probes[1]), false)
+  })
+
+  it('accepts the argv form db-update.mjs uses', () => {
+    assert.equal(asksOverTcp("'pg_isready',\n      '-h',\n      '127.0.0.1',"), true)
+  })
+})
diff --git a/scripts/pre-commit-hook.spec.mjs b/scripts/pre-commit-hook.spec.mjs
new file mode 100644
index 0000000..e985ba3
--- /dev/null
+++ b/scripts/pre-commit-hook.spec.mjs
@@ -0,0 +1,121 @@
+import assert from 'node:assert/strict'
+import { spawnSync } from 'node:child_process'
+import {
+  chmodSync,
+  copyFileSync,
+  mkdirSync,
+  mkdtempSync,
+  readFileSync,
+  rmSync,
+  writeFileSync,
+} from 'node:fs'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import { afterEach, beforeEach, describe, it } from 'node:test'
+import { fileURLToPath } from 'node:url'
+
+// .githooks/pre-commit run against a throwaway repository. Prettier is replaced by a stand-in that
+// rewrites UNFORMATTED to formatted in the files it is given, so the test sees exactly which files
+// the hook formatted and what it re-staged, without depending on node_modules. gitleaks is kept off
+// PATH, so its step is skipped.
+
+const workspaceRoot = dirname(dirname(fileURLToPath(import.meta.url)))
+const hookSource = join(workspaceRoot, '.githooks', 'pre-commit')
+
+const FAKE_PRETTIER = `#!/usr/bin/env node
+const { readFileSync, writeFileSync } = require('node:fs')
+const files = process.argv.slice(process.argv.indexOf('--') + 1)
+for (const file of files) writeFileSync(file, readFileSync(file, 'utf8').replaceAll('UNFORMATTED', 'formatted'))
+`
+
+let repo
+
+function git(...args) {
+  const result = spawnSync('git', args, { cwd: repo, encoding: 'utf8' })
+  assert.equal(result.status, 0, `git ${args.join(' ')} failed: ${result.stderr}`)
+  return result.stdout
+}
+
+function runHook() {
+  // PATH keeps only git's and node's directories, so a locally installed gitleaks is not found.
+  const gitPath = spawnSync('sh', ['-c', 'command -v git'], { encoding: 'utf8' }).stdout.trim()
+  const path = [dirname(process.execPath), dirname(gitPath), '/usr/bin', '/bin'].join(':')
+  return spawnSync('sh', [join(repo, '.githooks', 'pre-commit')], {
+    cwd: repo,
+    encoding: 'utf8',
+    env: { PATH: path, HOME: repo, GIT_CONFIG_NOSYSTEM: '1' },
+  })
+}
+
+function indexCopy(path) {
+  return git('show', `:${path}`)
+}
+
+describe('.githooks/pre-commit', () => {
+  beforeEach(() => {
+    repo = mkdtempSync(join(tmpdir(), 'pre-commit-hook-'))
+    git('init', '-q')
+    git('config', 'user.email', 'test@example.com')
+    git('config', 'user.name', 'Test')
+    git('config', 'commit.gpgsign', 'false')
+    mkdirSync(join(repo, '.githooks'))
+    copyFileSync(hookSource, join(repo, '.githooks', 'pre-commit'))
+    mkdirSync(join(repo, 'node_modules', '.bin'), { recursive: true })
+    writeFileSync(join(repo, 'node_modules', '.bin', 'prettier'), FAKE_PRETTIER)
+    chmodSync(join(repo, 'node_modules', '.bin', 'prettier'), 0o755)
+    writeFileSync(join(repo, '.gitignore'), 'node_modules/\n.claude/\n')
+    writeFileSync(join(repo, 'app.ts'), 'one\n')
+    git('add', '.gitignore', 'app.ts')
+    git('commit', '-q', '--no-verify', '-m', 'initial')
+  })
+
+  afterEach(() => {
+    rmSync(repo, { recursive: true, force: true })
+  })
+
+  it('formats a fully staged file and re-stages it', () => {
+    writeFileSync(join(repo, 'app.ts'), 'one\nUNFORMATTED\n')
+    git('add', 'app.ts')
+
+    const result = runHook()
+
+    assert.equal(result.status, 0, result.stderr)
+    assert.equal(indexCopy('app.ts'), 'one\nformatted\n')
+    assert.equal(readFileSync(join(repo, 'app.ts'), 'utf8'), 'one\nformatted\n')
+  })
+
+  it('refuses a partially staged file and leaves the index and work tree alone', () => {
+    writeFileSync(join(repo, 'app.ts'), 'one\nUNFORMATTED staged\n')
+    git('add', 'app.ts')
+    writeFileSync(join(repo, 'app.ts'), 'one\nUNFORMATTED staged\nnot staged\n')
+
+    const result = runHook()
+
+    assert.notEqual(result.status, 0)
+    assert.match(result.stderr, /REFUSED/)
+    assert.match(result.stderr, /^ {2}app\.ts$/m)
+    // Nothing was formatted, and above all the unstaged line did not reach the index.
+    assert.equal(indexCopy('app.ts'), 'one\nUNFORMATTED staged\n')
+    assert.equal(
+      readFileSync(join(repo, 'app.ts'), 'utf8'),
+      'one\nUNFORMATTED staged\nnot staged\n',
+    )
+  })
+
+  it('re-stages a force-added file that matches .gitignore', () => {
+    mkdirSync(join(repo, '.claude'))
+    writeFileSync(join(repo, '.claude', 'settings.json'), '{"UNFORMATTED": true}\n')
+    git('add', '-f', '.claude/settings.json')
+
+    const result = runHook()
+
+    assert.equal(result.status, 0, result.stderr)
+    assert.equal(indexCopy('.claude/settings.json'), '{"formatted": true}\n')
+  })
+
+  it('does nothing when nothing is staged', () => {
+    const result = runHook()
+
+    assert.equal(result.status, 0, result.stderr)
+  })
+})
