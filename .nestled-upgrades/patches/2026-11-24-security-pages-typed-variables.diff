+      ts.sys,
+      dirname(config),
+    )
+    const files = fileNames.map(file => relative(root, file).split(sep).join('/'))
+    assert.ok(
+      files.includes('apps/web/app/react-router-route-module.d.ts'),
+      'apps/web/tsconfig.app.json must include app/**/*.ts',
+    )
+  })
