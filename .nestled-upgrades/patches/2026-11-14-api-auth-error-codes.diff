@@ -0,0 +1,137 @@
+import { ApolloDriver, ApolloDriverConfig } from '@nestjs/apollo'
+import { ApolloServer } from '@apollo/server'
+import { INestApplication, UnauthorizedException } from '@nestjs/common'
+import { GraphQLModule, Query, Resolver } from '@nestjs/graphql'
+import { Test } from '@nestjs/testing'
+import type { GraphQLFormattedError } from 'graphql'
+import { CtxOrganization, CtxOrganizationId } from '../decorators/ctx-organization.decorator'
+import {
+  API_ERROR_CODES,
+  forbiddenWithCode,
+  formatApiError,
+  organizationContextRequired,
+} from './api-error-code'
+
+@Resolver()
+class ProbeResolver {
+  @Query(() => String)
+  organizationId(@CtxOrganizationId() organizationId: string): string {
+    return organizationId
+  }
+
+  @Query(() => String)
+  organizationName(@CtxOrganization() organization: { organizationId: string }): string {
+    return organization.organizationId
+  }
+
+  @Query(() => String)
+  deadSession(): string {
+    throw new UnauthorizedException('Session has been invalidated.')
+  }
+
+  @Query(() => String)
+  claimsUnauthenticated(): string {
+    throw forbiddenWithCode('UNAUTHENTICATED', 'A 403 may not mint a logout')
+  }
+}
+
+/**
+ * The real pipeline: `@nestjs/apollo`'s HTTP-exception mapping, then the API's `formatError`,
+ * configured as `ApiCoreFeatureModule` configures it.
+ */
+describe('API error codes over GraphQL', () => {
+  let app: INestApplication
+  let server: ApolloServer
+
+  beforeAll(async () => {
+    const moduleRef = await Test.createTestingModule({
+      imports: [
+        GraphQLModule.forRoot<ApolloDriverConfig>({
+          driver: ApolloDriver,
+          autoSchemaFile: true,
+          formatError: formatApiError,
+        }),
+      ],
+      providers: [ProbeResolver],
+    }).compile()
+    app = moduleRef.createNestApplication()
+    await app.init()
+    server = (app.get(GraphQLModule) as unknown as { graphQlAdapter: { instance: ApolloServer } })
+      .graphQlAdapter.instance
+  })
+
+  afterAll(async () => {
+    await app?.close()
+  })
+
+  const firstError = async (
+    query: string,
+    req: Record<string, unknown> = { user: { id: 'user-1' } },
+  ): Promise<GraphQLFormattedError> => {
+    const response = await server.executeOperation({ query }, { contextValue: { req } })
+    if (response.body.kind !== 'single') throw new Error('expected a single result')
+    const error = response.body.singleResult.errors?.[0]
+    if (!error) throw new Error('expected an error')
+    return error
+  }
+
+  it.each(['{ organizationId }', '{ organizationName }'])(
+    'answers a signed-in request with no organization context (%s) with a 403 ORGANIZATION_CONTEXT_REQUIRED, not UNAUTHENTICATED',
+    async query => {
+      const error = await firstError(query)
+
+      expect(error.extensions?.['code']).toBe('ORGANIZATION_CONTEXT_REQUIRED')
+      expect(error.extensions?.['originalError']).toMatchObject({ statusCode: 403 })
+      expect(error.message).toMatch(/organization context required/i)
+    },
+  )
+
+  it('still answers a dead session with UNAUTHENTICATED', async () => {
+    const error = await firstError('{ deadSession }')
+
+    expect(error.extensions?.['code']).toBe('UNAUTHENTICATED')
+  })
+
+  it('never lets a 403 claim UNAUTHENTICATED', async () => {
+    const error = await firstError('{ claimsUnauthenticated }')
+
+    expect(error.extensions?.['code']).toBe('FORBIDDEN')
+  })
+})
+
+describe('organizationContextRequired', () => {
+  it('is an HTTP 403 whose body carries the code', () => {
+    const error = organizationContextRequired()
+
+    expect(error.getStatus()).toBe(403)
+    expect(error.getResponse()).toMatchObject({
+      statusCode: 403,
+      code: API_ERROR_CODES.ORGANIZATION_CONTEXT_REQUIRED,
+    })
+    expect(error.message).toMatch(/organization context required/i)
+  })
+})
+
+describe('formatApiError', () => {
+  const formatted = (originalError: unknown, code = 'FORBIDDEN'): GraphQLFormattedError => ({
+    message: 'm',
+    extensions: { code, originalError },
+  })
+
+  it('leaves errors without a coded body alone', () => {
+    const error = formatted({ statusCode: 403, message: 'No permission' })
+    expect(formatApiError(error)).toBe(error)
+    const plain: GraphQLFormattedError = { message: 'm' }
+    expect(formatApiError(plain)).toBe(plain)
+  })
+
+  it('never sets a code on a 401', () => {
+    const error = formatted({ statusCode: 401, code: 'SOMETHING_ELSE' }, 'UNAUTHENTICATED')
+    expect(formatApiError(error).extensions?.['code']).toBe('UNAUTHENTICATED')
+  })
+
+  it('ignores a code that is not upper snake case', () => {
+    const error = formatted({ statusCode: 403, code: 'not a code' })
+    expect(formatApiError(error).extensions?.['code']).toBe('FORBIDDEN')
+  })
+})
diff --git a/libs/api/utils/src/lib/errors/api-error-code.ts b/libs/api/utils/src/lib/errors/api-error-code.ts
new file mode 100644
index 0000000..9eecdd3
--- /dev/null
+++ b/libs/api/utils/src/lib/errors/api-error-code.ts
@@ -0,0 +1,63 @@
+import { ForbiddenException } from '@nestjs/common'
+import type { GraphQLFormattedError } from 'graphql'
+
+/**
+ * GraphQL error codes the API sets on its own, beyond the ones `@nestjs/apollo` derives from an
+ * HTTP status (`UNAUTHENTICATED` for 401, `FORBIDDEN` for 403, `BAD_REQUEST` for 400, ...).
+ *
+ * Clients log a user out only on a 401 or `UNAUTHENTICATED`, so anything that is not "this session
+ * is missing, invalid or expired" must never be an `UnauthorizedException`. A refusal that a client
+ * should handle on its own terms (pick an organization, retry the provider sign-in) is a 403 with
+ * one of these codes instead. The web keeps the session for every one of them.
+ */
+export const API_ERROR_CODES = {
+  /** Signed in, but the request has no active organization, or one the user no longer belongs to. */
+  ORGANIZATION_CONTEXT_REQUIRED: 'ORGANIZATION_CONTEXT_REQUIRED',
+  /** The OAuth provider rejected the token or code it was given. Says nothing about the session. */
+  OAUTH_PROVIDER_REJECTED: 'OAUTH_PROVIDER_REJECTED',
+} as const
+
+export type ApiErrorCode = (typeof API_ERROR_CODES)[keyof typeof API_ERROR_CODES]
+
+const ORGANIZATION_CONTEXT_REQUIRED_MESSAGE =
+  'Organization context required. Please set X-Organization-ID header or ensure user has an active organization.'
+
+// Upper snake case, like the codes Apollo and Nest use.
+const ERROR_CODE_PATTERN = /^[A-Z][A-Z0-9_]*$/
+
+/**
+ * A 403 whose GraphQL error carries `extensions.code: code` (see `formatApiError`). Over REST it is
+ * an ordinary 403 whose JSON body also has `code`.
+ */
+export function forbiddenWithCode(code: string, message: string): ForbiddenException {
+  return new ForbiddenException({ statusCode: 403, error: 'Forbidden', message, code })
+}
+
+/** The request has no organization context: a 403 `ORGANIZATION_CONTEXT_REQUIRED`, never a 401. */
+export function organizationContextRequired(
+  message: string = ORGANIZATION_CONTEXT_REQUIRED_MESSAGE,
+): ForbiddenException {
+  return forbiddenWithCode(API_ERROR_CODES.ORGANIZATION_CONTEXT_REQUIRED, message)
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null
+}
+
+/**
+ * The GraphQL `formatError`. `@nestjs/apollo` runs first and replaces the code of every HTTP
+ * exception with the one for its status, keeping the exception's body as
+ * `extensions.originalError`. This puts back the code `forbiddenWithCode` gave the body. It never
+ * sets a code on a 401, and never sets `UNAUTHENTICATED`: only a real 401 may tell a client the
+ * session is dead.
+ */
+export function formatApiError(formattedError: GraphQLFormattedError): GraphQLFormattedError {
+  const originalError = formattedError.extensions?.['originalError']
+  if (!isRecord(originalError)) return formattedError
+
+  const { code, statusCode } = originalError
+  if (typeof code !== 'string' || !ERROR_CODE_PATTERN.test(code)) return formattedError
+  if (statusCode === 401 || code === 'UNAUTHENTICATED') return formattedError
+
+  return { ...formattedError, extensions: { ...formattedError.extensions, code } }
+}
