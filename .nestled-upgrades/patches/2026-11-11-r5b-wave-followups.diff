+    setup({ fetchMorePage })
+
+    act(() => FakeIntersectionObserver.latest().report(true))
+    act(() => FakeIntersectionObserver.latest().report(true))
+
+    expect(fetchMorePage).toHaveBeenCalledTimes(1)
+  })
+
+  it('marks the list loaded after a short page and stops fetching', async () => {
