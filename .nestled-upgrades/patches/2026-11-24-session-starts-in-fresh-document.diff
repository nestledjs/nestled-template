+export function __resetSessionUserGuard(): void {
+  lastSignedInUserId = undefined
+  reloading = false
+  restoredWith = undefined
+  clearTimeout(restoreTimer)
+  document.documentElement.removeAttribute(CHECKING_ATTRIBUTE)
