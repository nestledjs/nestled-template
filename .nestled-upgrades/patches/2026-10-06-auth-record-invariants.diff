diff --git a/libs/api/generated-crud/data-access/src/lib/retry-write.ts b/libs/api/generated-crud/data-access/src/lib/retry-write.ts
new file mode 100644
index 0000000..66e500f
--- /dev/null
+++ b/libs/api/generated-crud/data-access/src/lib/retry-write.ts
@@ -0,0 +1,20 @@
+/** Retry a complete, standalone Prisma write only when its transaction was rolled back. */
+export async function retryWrite<T>(write: () => Promise<T>): Promise<T> {
+  for (let attempt = 0; ; attempt++) {
+    try {
+      return await write()
+    } catch (error) {
+      if (
+        attempt >= 5 ||
+        typeof error !== 'object' ||
+        error === null ||
+        !('code' in error) ||
+        error.code !== 'P2034'
+      ) {
+        throw error
+      }
+      // Back off with jitter so conflicting writers do not repeatedly retry together.
+      await new Promise(resolve => setTimeout(resolve, 50 * 2 ** attempt + Math.random() * 50))
+    }
+  }
+}
