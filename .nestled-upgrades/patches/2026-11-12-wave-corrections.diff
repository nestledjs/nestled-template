+export function staleConfigReferences(files, readFile) {
+  const tracked = new Set(files)
+  const resolves = path =>
+    CONFIG_REFERENCE.exec(path)?.[3]
+      ? tracked.has(path)
+      : EXTENSIONLESS_CANDIDATES.some(extension => tracked.has(path + extension))
