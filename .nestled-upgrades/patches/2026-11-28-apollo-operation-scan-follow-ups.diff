+    ["preloadQuery(Doc, { variables, fetchPolicy: 'no-cache' })", 1],
+    ['preloadQuery(Doc, { fetchPolicy: "no-cache" })', 1],
+    ["preloadQuery(Doc, { fetchPolicy: 'network-only' })", 0],
+    ['preloadQuery(Doc)', 0],
