+import { describe, expect, it, vi } from 'vitest'
+import {
+  API_OUTPUT_TAIL_LINES,
+  DEFAULT_API_START_TIMEOUT_SECONDS,
+  apiStartTimeoutSeconds,
+  lastOutputLines,
+} from './api-readiness'
+
+describe('apiStartTimeoutSeconds', () => {
+  it('defaults to a budget long enough for a cold build', () => {
+    expect(apiStartTimeoutSeconds({})).toBe(DEFAULT_API_START_TIMEOUT_SECONDS)
+    expect(DEFAULT_API_START_TIMEOUT_SECONDS).toBeGreaterThanOrEqual(180)
+  })
+
+  it('uses E2E_API_START_TIMEOUT_SECONDS when it is a positive whole number', () => {
+    expect(apiStartTimeoutSeconds({ E2E_API_START_TIMEOUT_SECONDS: '420' })).toBe(420)
+    expect(apiStartTimeoutSeconds({ E2E_API_START_TIMEOUT_SECONDS: ' 90 ' })).toBe(90)
+  })
+
+  it('falls back to the default, and says so, for an unusable value', () => {
+    for (const value of ['0', '-5', '1.5', 'ten', '60s']) {
+      const warn = vi.fn()
+      expect(apiStartTimeoutSeconds({ E2E_API_START_TIMEOUT_SECONDS: value }, warn)).toBe(
+        DEFAULT_API_START_TIMEOUT_SECONDS,
+      )
+      expect(warn).toHaveBeenCalledOnce()
+      expect(warn.mock.calls[0][0]).toContain(value)
+    }
+  })
+
+  it('treats an empty value as unset', () => {
+    const warn = vi.fn()
+    expect(apiStartTimeoutSeconds({ E2E_API_START_TIMEOUT_SECONDS: '  ' }, warn)).toBe(
+      DEFAULT_API_START_TIMEOUT_SECONDS,
+    )
+    expect(warn).not.toHaveBeenCalled()
+  })
+})
+
+describe('lastOutputLines', () => {
+  it('keeps only the last lines, skipping blank ones', () => {
+    const output = Array.from({ length: 100 }, (_, i) => `line ${i + 1}`).join('\n\n')
+    const tail = lastOutputLines(output).split('\n')
+    expect(tail).toHaveLength(API_OUTPUT_TAIL_LINES)
+    expect(tail[0]).toBe(`line ${100 - API_OUTPUT_TAIL_LINES + 1}`)
+    expect(tail.slice(-1)).toEqual(['line 100'])
+  })
+
+  it('handles Windows line endings and a custom count', () => {
+    expect(lastOutputLines('a\r\nb\r\nc\r\n', 2)).toBe('b\nc')
+  })
+
+  it('says so when the API printed nothing', () => {
+    expect(lastOutputLines('')).toBe('(the API printed nothing)')
+    expect(lastOutputLines('\n \n')).toBe('(the API printed nothing)')
+  })
+})
diff --git a/apps/api-e2e/src/support/api-readiness.ts b/apps/api-e2e/src/support/api-readiness.ts
new file mode 100644
index 0000000..4ca350d
--- /dev/null
+++ b/apps/api-e2e/src/support/api-readiness.ts
@@ -0,0 +1,32 @@
+// How long global setup waits for the API it started to accept connections, and what it prints when
+// the API does not. `nx serve api` builds the API with webpack before it listens; on a cold CI
+// machine (no Nx cache, no webpack cache) that build alone can take longer than a minute, so the
+// wait is generous by default and configurable with E2E_API_START_TIMEOUT_SECONDS.
+
+export const DEFAULT_API_START_TIMEOUT_SECONDS = 300
+export const API_OUTPUT_TAIL_LINES = 40
+
+/**
+ * The readiness budget in whole seconds: E2E_API_START_TIMEOUT_SECONDS when it is a positive whole
+ * number, the default otherwise. An unusable value is reported rather than silently ignored.
+ */
+export function apiStartTimeoutSeconds(
+  env: NodeJS.ProcessEnv = process.env,
+  warn: (message: string) => void = console.warn,
+): number {
+  const raw = env.E2E_API_START_TIMEOUT_SECONDS?.trim()
+  if (!raw) return DEFAULT_API_START_TIMEOUT_SECONDS
+  if (/^\d+$/.test(raw) && Number(raw) > 0) return Number(raw)
+  warn(
+    `E2E_API_START_TIMEOUT_SECONDS="${raw}" is not a positive whole number of seconds; ` +
+      `using ${DEFAULT_API_START_TIMEOUT_SECONDS}.`,
+  )
+  return DEFAULT_API_START_TIMEOUT_SECONDS
+}
+
+/** The last `count` non-empty lines of the API's output, for a readiness failure. */
+export function lastOutputLines(output: string, count = API_OUTPUT_TAIL_LINES): string {
+  const lines = output.split(/\r?\n/).filter(line => line.trim() !== '')
+  if (lines.length === 0) return '(the API printed nothing)'
+  return lines.slice(-count).join('\n')
+}
