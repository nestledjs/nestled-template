@@ -0,0 +1,26 @@
+name: Set up the workspace
+description: >-
+  Checkout is the caller's (fetch depth differs per job). This installs pnpm and Node, the
+  dependencies, and the Prisma client, which almost every CI job needs. Install runs with
+  --ignore-scripts (no lifecycle scripts, so `prepare` never wires the git hooks here), and a job
+  that is not building the API never runs the Prisma generate target, so the client is generated
+  explicitly: any suite or compiler importing the generated client fails without it.
+
+runs:
+  using: composite
+  steps:
+    - uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1 # v4
+      with:
+        run_install: false
+
+    - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
+      with:
+        node-version: 22.23.4
+        cache: 'pnpm'
+
+    - run: pnpm install --frozen-lockfile --ignore-scripts
+      shell: bash
+
+    - name: Generate Prisma client
+      run: pnpm prisma:generate
+      shell: bash
