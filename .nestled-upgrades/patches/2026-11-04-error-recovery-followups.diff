+    expect(reload).toHaveBeenCalledTimes(1)
+  })
+})
diff --git a/apps/web/tests/routes/authenticated-layout-me-recovery.spec.tsx b/apps/web/tests/routes/authenticated-layout-me-recovery.spec.tsx
new file mode 100644
