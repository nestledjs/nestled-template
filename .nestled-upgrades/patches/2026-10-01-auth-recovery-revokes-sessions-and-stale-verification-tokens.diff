@@ -44,6 +44,26 @@ export function generateToken(): string {
   return randomBytes(32).toString('hex')
 }
 
+/**
+ * Marks signup email-verification tokens minted by code that binds them to the current primary
+ * address (see AuthService.mintVerificationTokenForPrimary). Tokens without it were minted by the
+ * earlier code, which could hand a primary-verifying token to an address that never controlled the
+ * primary, so verifyEmail() refuses them.
+ *
+ * A marker rather than a migration that clears old tokens: during a rolling deploy the previous
+ * release keeps serving, and can mint an unbound token after any pre-deploy migration has run.
+ * Bump the version if the binding rules change again.
+ */
+export const EMAIL_VERIFICATION_TOKEN_PREFIX = 'v2-'
+
+export function generateEmailVerificationToken(): string {
+  return `${EMAIL_VERIFICATION_TOKEN_PREFIX}${generateToken()}`
+}
+
+export function isCurrentEmailVerificationToken(token: string): boolean {
+  return token.startsWith(EMAIL_VERIFICATION_TOKEN_PREFIX)
+}
+
 export function generateExpireDate(days = 1) {
   return new Date(Date.now() + 60 * 60 * 24 * 1000 * days)
 }
