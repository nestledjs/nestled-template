#!/usr/bin/env sh
# Runs before every commit, on the staged files only:
#
# 1. Prettier formats them and they are re-staged, so CI's tree-wide formatting gate
#    (`prettier --check .`) never fails for a file committed from here. That gate is the most
#    common reason a run goes red, each a full CI round trip for a one-second fix.
# 2. gitleaks scans what is staged for secrets, when it is installed. CI's gitleaks job is the
#    enforced layer; this one only catches a secret before it is in history at all.
#
# Wired up by package.json's `prepare` script (`git config core.hooksPath .githooks || true`) on
# `pnpm install`. CI installs with --ignore-scripts and never runs it; a build without `.git`
# (Railway, Docker) skips it through the `|| true`. No dependency is involved on purpose: husky
# and lint-staged add transitive packages that re-key the pnpm lockfile.
#
# Prettier gets the staged paths explicitly and still honours .prettierignore; --ignore-unknown
# skips files it has no parser for. The formatted files are re-staged whole, so a PARTIALLY staged
# file (`git add -p`, unstaged edits on top of staged ones) is refused rather than formatted:
# re-staging it would commit the unstaged hunks too. Never bypass this hook with --no-verify.
set -e
# -z: NUL-separated and never C-quoted, so a path with spaces or non-ASCII characters reaches
# Prettier and `git add` as it is. Without it git quotes such paths ("docs/caf\303\251.md").
staged_paths() {
  git diff --cached --name-only --diff-filter=ACMR -z
}
[ -n "$(staged_paths | tr '\0' '\n')" ] || exit 0

# A missing formatter must not wedge the commit. Called unconditionally, the hook would abort with
# `xargs: node_modules/.bin/prettier: No such file or directory` in any checkout without
# node_modules (a fresh worktree, a cloud session whose install failed), and the only way past a
# failing hook is --no-verify, which this repository forbids. Say what is wrong and let the commit
# through: the blocking gate is CI's `prettier --check .`, not this.
if [ -x node_modules/.bin/prettier ]; then
  # A staged path that also has unstaged changes. Formatting the work-tree file and re-staging it
  # would silently add those unstaged hunks to the commit, so stop and say which paths.
  partially_staged="$(staged_paths | xargs -0 git diff --name-only --)"
  if [ -n "$partially_staged" ]; then
    echo "pre-commit: REFUSED. These staged files also have unstaged changes:" >&2
    printf '%s\n' "$partially_staged" | sed 's/^/  /' >&2
    echo "The hook formats and re-stages whole files, which would commit the unstaged hunks too." >&2
    echo "Stage the whole file (\`git add <path>\`), or set the unstaged hunks aside with" >&2
    echo "\`git stash push --keep-index\`, commit, then \`git stash pop\`." >&2
    exit 1
  fi
  staged_paths | xargs -0 node_modules/.bin/prettier --write --ignore-unknown --log-level warn --
  # -f: every path is already in the index, so an ignore rule must not abort the commit. Without
  # it `git add` refuses a force-added path that matches .gitignore (`.claude/settings.json` under
  # an ignored `.claude/`) and the hook fails.
  staged_paths | xargs -0 git add -f --
else
  echo "pre-commit: NOT FORMATTED. node_modules/.bin/prettier is missing, so the staged files" >&2
  echo "were left as they are. Run \`pnpm install\`, or \`pnpm exec prettier --write\` on the files" >&2
  echo "you changed, before you push: CI's \`prettier --check .\` is blocking." >&2
fi

# The secret scan runs after formatting, on exactly what will be committed. gitleaks reads
# .gitleaks.toml at the repository root. A finding blocks the commit: remove the secret from the
# staged change (and rotate it if it was real). A false positive goes in .gitleaks.toml's allowlist.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner --verbose --log-level warn
else
  echo "pre-commit: gitleaks is not installed; secret scan skipped (CI runs it)." >&2
fi
