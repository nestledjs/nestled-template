APP_NAME=your-app-name
NODE_ENV=development
JWT_SECRET=JWT_SECRET

## LOCAL DEV PORTS
# Every nestled app defaults to block 0, so only one can run at a time. To run several side by
# side, choose a unique private allocation starting at block 1, record it in a private team
# inventory, and set the whole block below. App ports stride by 1; infrastructure ports stride by
# 10. Never commit real repo/client mappings, local sites, or IP ranges to a public template.
# `pnpm nestled-doctor` warns when one half of a pair has moved and the other has not.
#
# PAIR 1 — API port. PORT and VITE_API_URL must move together, or the browser calls the old
#          port and every request 404s/hangs. FAILS SILENTLY: the API starts fine.
PORT=3000
API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000
#
# PAIR 2 — Web port. WEB_PORT and ALLOWED_ORIGINS must move together, or CORS blocks every
#          request from the browser. FAILS SILENTLY: both processes start fine.
#          ALLOWED_ORIGINS is comma-separated, and it is SET below — so the explicit list is what
#          applies and you must move it yourself. The WEB_URL / http://localhost:${WEB_PORT}
#          fallback engages only if you empty or remove it.
WEB_PORT=4200
WEB_PREVIEW_PORT=4300
SITE_URL=http://localhost:4200
ALLOWED_ORIGINS=http://localhost:4200
# The browser origin the web app is served from. Only consulted for CORS when ALLOWED_ORIGINS is
# empty; otherwise the origin derives from WEB_PORT. MUST BE ORIGIN-ONLY — scheme + host +
# optional port, with no trailing slash, path, or credentials — because it is compared against the
# browser's Origin header by exact string equality. A value that is not an origin is collapsed to
# one; a value that cannot be an origin (scheme-less, non-http(s)) is ignored in favour of
# http://localhost:${WEB_PORT}.
# WEB_URL=http://localhost:4200
# Bind address for the vite dev/preview server. Leave unset for localhost; set to 0.0.0.0 to
# reach the dev server from another device on the LAN.
# VITE_HOST=0.0.0.0

## LOCAL DOCKER INFRA PORTS
# Host-side bindings only — container ports never change. Read by `pnpm docker:up` /
# `pnpm test:db:*` via scripts/dev-docker.sh, which passes this file to compose with --env-file.
#
# PAIR 3 — POSTGRES_PORT must match the port in DATABASE_URL (and DIRECT_URL if set).
#          FAILS SILENTLY AND WORST: a stale DATABASE_URL connects to ANOTHER repo's database.
POSTGRES_PORT=5432
# PAIR 4 — POSTGRES_TEST_PORT must match TEST_DATABASE_URL (used by pnpm test:e2e).
POSTGRES_TEST_PORT=5433
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nestled_template_test
# PAIR 5 — REDIS_PORT must match REDIS_URL when REDIS_URL is set.
REDIS_PORT=6379
# PAIR 6 — MAILHOG_SMTP_PORT must match SMTP_PORT when SMTP_HOST is localhost.
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

## SESSION COOKIE
# Cookie name for session token (shared between API and web app)
VITE_COOKIE_NAME=__session
# Cookie signing secret (API only)
API_COOKIE_SECRET=change-this-in-production
# Cookie Domain attribute the API sets on the session cookie.
# Leave as `localhost` for local dev. For a SPLIT web/API subdomain deploy
# (e.g. app.example.com + api.example.com), set this to the shared registrable
# domain with a leading dot: API_COOKIE_DOMAIN=.example.com
API_COOKIE_DOMAIN=localhost
# MUST match API_COOKIE_DOMAIN on split-subdomain deploys so the WEB app can
# clear the domain-scoped session cookie (otherwise forced logout cannot remove
# the cookie and you risk a login↔dashboard redirect loop — see PIR-173).
# Leave unset/empty for single-host or localhost deploys.
# VITE_COOKIE_DOMAIN=.example.com

## DEVELOPMENT DATABASE
# PAIR 3 — the port here must match POSTGRES_PORT above, or you silently connect to whatever
# other repo's Postgres is bound to that port.
DATABASE_URL=postgresql://prisma:prisma@localhost:5432/prisma
# DIRECT_URL is the direct (non-pooled) Postgres connection used by the Prisma CLI —
# migrations, db push, studio (see prisma.config.ts, which prefers it over DATABASE_URL).
# On Railway, DATABASE_URL is the pgbouncer/pooled URL (port 6432) and DIRECT_URL is the
# direct Postgres URL, so `prisma migrate deploy` needs no manual URL swap. Locally there
# is no pooler in front, so DIRECT_URL can be left unset (it falls back to DATABASE_URL).
# When set locally, its port must match POSTGRES_PORT too (PAIR 3).
# DIRECT_URL=postgresql://prisma:prisma@localhost:5432/prisma
# PAIR 5 — when set, the port here must match REDIS_PORT above.
#REDIS_URL=redis://localhost:6379


## EMAILS
APP_EMAIL=test@test.com
APP_SUPPORT_EMAIL=test@test.com
APP_ADMIN_EMAILS=test@test.com,admin@test.com

## EMAIL PROVIDER
# Options: smtp, mock (for testing/CI)
# EMAIL_PROVIDER=smtp

## SMTP SETTINGS
# For local development, you can use:
# - Mailhog: SMTP_HOST=localhost, SMTP_PORT=1025 (no auth needed)
# - Mailtrap: Use their provided SMTP settings
# For production, use your email provider's SMTP settings (SendGrid, AWS SES, etc.)
# PAIR 6 — with SMTP_HOST=localhost, SMTP_PORT must match MAILHOG_SMTP_PORT above.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test

## TWO-FACTOR AUTHENTICATION (2FA)
# Issuer name displayed in authenticator apps (defaults to APP_NAME if not set)
TWO_FACTOR_ISSUER=your-app-name
# Time window for TOTP verification (in 30-second increments, 2 = 60 seconds tolerance)
TWO_FACTOR_WINDOW=2
# Encryption key for 2FA secrets (defaults to JWT_SECRET if not set, must be 32+ characters)
# IMPORTANT: Change this in production! Generate with: openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=change-this-to-a-random-32-character-key

## OAUTH PROVIDERS (optional)
# OAuth is optional. Leave these commented out to disable social login; the API starts normally.
# Uncomment and fill in real credentials to enable a provider (placeholder `your-*` values are
# treated as NOT configured, so an uncommented placeholder will not falsely enable the provider).
# Google OAuth (get credentials from: https://console.cloud.google.com/apis/credentials)
# Redirect URI: {API_URL}/api/auth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (get credentials from: https://github.com/settings/developers)
# Authorization callback URL: {API_URL}/api/auth/github/callback
# GITHUB_OAUTH_CLIENT_ID=your-github-client-id
# GITHUB_OAUTH_CLIENT_SECRET=your-github-client-secret

## Logging & Tools ##
LOG_PRISMA_QUERIES=true
COUNT_PRISMA_QUERIES=true
QUERY_COMPLEXITY_LIMIT=15000
LOG_QUERY_COMPLEXITY=false
LOG_QUERY_COMPLEXITY_THRESHOLD=5000
QUERY_COMPLEXITY_VERBOSE_ERRORS=false
DEBUG_CONFIG=false

## SIGNUP ABUSE PROTECTION ##
# The register, resendVerificationEmail, and forgotPassword mutations are unauthenticated and send
# email off unverified input (forgotPassword only when the address matches a user), which makes them
# a spam vector aimed at your sender reputation. These settings (captcha + rate limit) gate all three.

# Number of reverse proxies in front of the API. THIS IS A SECURITY SETTING: the signup rate limit
# keys on the client IP, and Express only derives that correctly from X-Forwarded-For when it knows
# how many hops to trust.
#   0 (default) = no proxy. Correct for local dev.
#   1           = Railway, Heroku, Fly, or a single nginx in front.
# Leave it at 0 behind a proxy and every user shares one rate-limit bucket, throttling everybody
# together. Set it too high and clients can forge X-Forwarded-For to bypass the limit entirely.
TRUST_PROXY_HOPS=0

# Cloudflare Turnstile (optional, free). Unset = disabled, and register accepts a missing token —
# so existing deployments keep working. This is the single most effective control here; set it
# before opening signups to the public. Keys: https://dash.cloudflare.com/?to=/:account/turnstile
# TURNSTILE_SECRET_KEY=0x4AAA...
# The site key is public and belongs to the web app, not the API:
# VITE_TURNSTILE_SITE_KEY=0x4AAA...

# Per-IP rate limit on register, resendVerificationEmail, and forgotPassword. Defaults to 3 per hour, and is disabled
# automatically under NODE_ENV=test so e2e suites can register freely.
# SIGNUP_THROTTLE_ENABLED=true
# SIGNUP_THROTTLE_TTL=3600
# SIGNUP_THROTTLE_LIMIT=3

# Reject addresses whose domain publishes no MX (or A) record. Costs a DNS round trip and rejects
# the fake domains dev/test fixtures use, so it defaults ON in production and OFF everywhere else.
# SIGNUP_REQUIRE_MX=true
# SIGNUP_MX_TIMEOUT_MS=3000

# Reject known disposable/throwaway email domains. Defaults ON in every environment.
# SIGNUP_BLOCK_DISPOSABLE=true

## STRIPE BILLING (optional) ##
# Stripe is optional. If not set, billing features are disabled but the API starts normally.
# Get your test keys from: https://dashboard.stripe.com/test/apikeys
# For production, switch to live keys from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Get webhook secret after setting up webhook endpoint in Stripe dashboard
# Local testing: Use `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=usd
